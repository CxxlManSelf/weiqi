        document.getElementById('study-nav-prev')?.addEventListener('click', () => stepStudyCursor(-1));
        document.getElementById('study-nav-next')?.addEventListener('click', () => stepStudyCursor(1));
        document.getElementById('study-nav-end')?.addEventListener('click', () => stepStudyCursor(9999));
        document.getElementById('study-undo-btn')?.addEventListener('click', undoStudyMove);
        document.getElementById('spec-nav-start')?.addEventListener('click', () => stepStudyCursor(-9999));
        document.getElementById('spec-nav-prev')?.addEventListener('click', () => stepStudyCursor(-1));
        document.getElementById('spec-nav-next')?.addEventListener('click', () => stepStudyCursor(1));
        document.getElementById('spec-nav-end')?.addEventListener('click', () => stepStudyCursor(9999));
        document.getElementById('spec-undo-btn')?.addEventListener('click', undoStudyMove);
        document.getElementById('spec-add-branch-btn')?.addEventListener('click', createSpectatorLocalBranch);
        document.getElementById('spec-return-live-btn')?.addEventListener('click', returnSpectatorToPresenterLive);
        document.getElementById('study-rezero-btn')?.addEventListener('click', rezeroStudyMoves);
        document.getElementById('study-quick-branch-btn')?.addEventListener('click', createNewStudyBranch);
        document.getElementById('study-add-branch-btn')?.addEventListener('click', createNewStudyBranch);
        document.getElementById('study-rename-branch-btn')?.addEventListener('click', renameActiveStudyBranch);
        document.getElementById('study-delete-branch-btn')?.addEventListener('click', deleteActiveStudyBranch);
        document.getElementById('study-clear-btn')?.addEventListener('click', clearStudyBoard);
        document.getElementById('study-release-btn')?.addEventListener('click', releaseStudyControl);
        document.getElementById('study-takeover-btn')?.addEventListener('click', takeOverStudyControl);
        document.getElementById('study-quick-takeover-btn')?.addEventListener('click', takeOverStudyControl);
        document.getElementById('study-save-sgf-btn')?.addEventListener('click', openSaveSgfModal);
        document.getElementById('study-load-sgf-btn')?.addEventListener('click', openLoadSgfModal);

        // 主講人盤面註釋按鈕與彈窗
        document.getElementById('study-add-note-btn')?.addEventListener('click', openStudyNoteModal);
        document.querySelectorAll('.study-note-tag-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const ta = document.getElementById('study-note-textarea');
            if (!ta) return;
            const tag = btn.dataset.noteTag || '';
            ta.value = `${tag}${ta.value}`;
            ta.focus();
          });
        });
        document.getElementById('study-note-form')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const ta = document.getElementById('study-note-textarea');
          sendStudyNoteMessage(ta?.value || '');
        });

        document.getElementById('study-mode-play-btn')?.addEventListener('click', () => {
          appState.studyToolMode = 'play';
          updateStudyPanelUI();
        });
        document.getElementById('study-mode-setup-btn')?.addEventListener('click', () => {
          appState.studyToolMode = 'setup';
          updateStudyPanelUI();
        });
        document.querySelectorAll('.study-setup-tool-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            appState.studySetupColor = btn.dataset.setupTool || 'B';
            updateStudyPanelUI();
          });
        });

        document.getElementById('study-branches-list')?.addEventListener('click', (e) => {
          const chip = e.target.closest('[data-branch-id]');
          if (chip) switchStudyBranch(chip.dataset.branchId);
        });

        // 儲存 / 匯出棋譜彈窗事件
        document.getElementById('save-to-my-records-btn')?.addEventListener('click', () => {
          const title = document.getElementById('save-sgf-title-input')?.value;
          const sgf = document.getElementById('save-sgf-preview')?.value;
          const saved = saveRecordToLibrary(title, sgf, state?.boardSize || 19);
          if (saved) closeAllModals();
        });
        document.getElementById('download-sgf-file-btn')?.addEventListener('click', () => {
          const title = document.getElementById('save-sgf-title-input')?.value.trim() || 'weiqi_game';
          const sgf = document.getElementById('save-sgf-preview')?.value || '';
          downloadTextFile(`${title}.sgf`, sgf);
        });
        document.getElementById('copy-sgf-text-btn')?.addEventListener('click', () => {
          const sgf = document.getElementById('save-sgf-preview')?.value || '';
          copyTextToClipboard(sgf, '已複製 SGF 棋譜文字');
        });

        // 載入棋譜彈窗事件
        document.getElementById('load-modal-records-list')?.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-load-record-into-study]');
          if (btn) {
            const rec = appState.records.find((r) => r.id === btn.dataset.loadRecordIntoStudy);
            if (rec) loadSgfIntoCurrentStudy(rec.sgf);
          }
        });
        document.getElementById('load-sgf-file-input')?.addEventListener('change', (e) => {
          const file = e.target.files?.[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = () => {
            if (reader.result) loadSgfIntoCurrentStudy(String(reader.result));
          };
          reader.readAsText(file);
          e.target.value = '';
        });
        document.getElementById('confirm-paste-sgf-btn')?.addEventListener('click', () => {
          const txt = document.getElementById('load-sgf-textarea')?.value.trim();
          if (!txt) {
            showToast('請先貼上 SGF 內容');
            return;
          }
          loadSgfIntoCurrentStudy(txt);
        });

        // 房內即時聊天室與手機分頁切換
        document.getElementById('mobile-tab-control')?.addEventListener('click', () => {
          appState.mobileRoomTab = 'control';
          updateMobileRoomTabUI();
        });
        document.getElementById('mobile-tab-chat')?.addEventListener('click', () => {
          appState.mobileRoomTab = 'chat';
          updateMobileRoomTabUI();
        });
        document.getElementById('room-chat-form')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const inp = document.getElementById('room-chat-input');
          if (inp && inp.value.trim()) {
            sendRoomChatMessage(inp.value);
            inp.value = '';
          }
        });
        document.querySelectorAll('.room-quick-btn').forEach((btn) => {
          btn.addEventListener('click', () => sendRoomChatMessage(btn.dataset.roomQuick));
        });
      }

      function resetClocksOnly() {
        if (!state) return;
        const inByo = state.mainTime === 0 && state.byoyomiSeconds > 0;
        state.clocks = {
          B: { main: state.mainTime, byoLeft: state.byoyomiSeconds, periodsLeft: state.byoyomiPeriods, inByo },
          W: { main: state.mainTime, byoLeft: state.byoyomiSeconds, periodsLeft: state.byoyomiPeriods, inByo }
        };
        state.lastTickAt = Date.now();
        persistCurrentRoomAndSync(true);
        updateClockDisplayOnly();
      }

      function downloadTextFile(filename, content) {
        const blob = new Blob([content], { type: 'application/x-go-sgf;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }

      // 啟動應用程式（透過 Firebase Realtime Database 即時同步）
      (async () => {
        await hydrateStorageBeforeBoot();

        window.addEventListener('hashchange', () => {
          const target = getPendingRoomParamFromUrl();
          if (target && (!state || (state.id !== target && String(state.code) !== target))) {
            appState.pendingAutoJoinRoom = target;
            fetchAndJoinRemoteRoomByParam(target);
          }
        });

        appState.pendingAutoJoinRoom = getPendingRoomParamFromUrl();
        if (appState.pendingAutoJoinRoom) {
          showToast(`正在尋找並進入房間 #${appState.pendingAutoJoinRoom}...`, 3500);
          setTimeout(() => {
            if (appState.pendingAutoJoinRoom && !state) {
              const missingCode = appState.pendingAutoJoinRoom;
              appState.pendingAutoJoinRoom = '';
              syncBrowserUrlWithRoom(null);
              showToast(`找不到房間 #${missingCode}，可能已被房主刪除或輸入有誤`, 4000);
            }
          }, 7500);
        }
        bindAllEvents();
        renderLobbyRooms();
        renderLobbyChat();
        await initSyncBackend();
      })();
    })();
  </script>
</body>
</html>
