      // ==================== 11. 棋盤繪製與觸控落子（傳統榧木棋盤與立體棋子） ====================
      const canvas = document.getElementById('go-board');
      const ctx = canvas ? canvas.getContext('2d') : null;
      let boardMetrics = { size: 19, padding: 24, cellSize: 30, cssSize: 600 };

      function resizeAndDrawBoard() {
        if (!canvas || !ctx || !state) return;
        const container = document.getElementById('board-viewport');
        if (!container) return;
        const rect = container.getBoundingClientRect();
        const w = rect.width || container.clientWidth || 320;
        const h = rect.height || w;
        const cssSize = Math.max(220, Math.floor(Math.min(w, h)));
        const dpr = Math.min(window.devicePixelRatio || 1, 3);

        canvas.width = cssSize * dpr;
        canvas.height = cssSize * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const size = state.boardSize || 19;
        const padding = Math.max(20, Math.round(cssSize * 0.056));
        const cellSize = (cssSize - padding * 2) / (size - 1);
        boardMetrics = { size, padding, cellSize, cssSize };

        drawBoard();
      }

      if (typeof ResizeObserver !== 'undefined') {
        const viewportEl = document.getElementById('board-viewport');
        if (viewportEl) {
          const ro = new ResizeObserver(() => {
            if (state) resizeAndDrawBoard();
          });
          ro.observe(viewportEl);
        }
      }

      function drawBoard() {
        if (!ctx || !state) return;
        const { size, padding, cellSize, cssSize } = boardMetrics;

        // 1. 溫潤傳統日本榧木（Kaya）底色漸層
        const grad = ctx.createLinearGradient(0, 0, cssSize, cssSize);
        grad.addColorStop(0, '#eab96b');
        grad.addColorStop(0.5, '#dfa852');
        grad.addColorStop(1, '#cf933b');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, cssSize, cssSize);

        // 2. 細緻縱向天然木紋
        ctx.save();
        for (let x = 2; x < cssSize; x += 3) {
          const wave = Math.sin(x * 0.045) * 0.5 + Math.cos(x * 0.13) * 0.5;
          if (wave > 0.1) {
            ctx.fillStyle = `rgba(146, 88, 28, ${(wave * 0.045).toFixed(3)})`;
            ctx.fillRect(x, 0, 1.4, cssSize);
          }
        }
        ctx.restore();

        // 3. 四邊溫潤木框倒角與內高光
        ctx.strokeStyle = 'rgba(255, 240, 210, 0.35)';
        ctx.lineWidth = 2;
        ctx.strokeRect(1, 1, cssSize - 2, cssSize - 2);
        ctx.strokeStyle = 'rgba(104, 62, 18, 0.45)';
        ctx.lineWidth = 2;
        ctx.strokeRect(0.5, 0.5, cssSize - 1, cssSize - 1);

        // 4. 棋盤格線（外框加粗、內線俐落）
        ctx.strokeStyle = '#2d1a08';
        ctx.lineCap = 'square';
        for (let i = 0; i < size; i++) {
          const pos = Math.round(padding + i * cellSize) + 0.5;
          const start = Math.round(padding) + 0.5;
          const end = Math.round(cssSize - padding) + 0.5;
          ctx.lineWidth = i === 0 || i === size - 1 ? 1.8 : 1;

          ctx.beginPath();
          ctx.moveTo(start, pos);
          ctx.lineTo(end, pos);
          ctx.stroke();

          ctx.beginPath();
          ctx.moveTo(pos, start);
          ctx.lineTo(pos, end);
          ctx.stroke();
        }

        // 5. 星位黑點
        const starCoords = getStarPoints(size);
        ctx.fillStyle = '#241405';
        const starR = Math.max(2.6, cellSize * 0.115);
        for (const [sx, sy] of starCoords) {
          ctx.beginPath();
          ctx.arc(padding + sx * cellSize, padding + sy * cellSize, starR, 0, Math.PI * 2);
          ctx.fill();
        }

        // 6. 四周圍棋座標（A-T 跳過 I，數字 1-19）
        const fontSize = Math.max(9, Math.min(12, Math.floor(padding * 0.46)));
        ctx.fillStyle = '#4a2c10';
        ctx.font = `700 ${fontSize}px -apple-system, BlinkMacSystemFont, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        for (let i = 0; i < size; i++) {
          const pos = padding + i * cellSize;
          const colChar = COLS_STR[i] || '';
          const rowNum = String(size - i);
          ctx.fillText(colChar, pos, padding * 0.44);
          ctx.fillText(colChar, pos, cssSize - padding * 0.44);
          ctx.fillText(rowNum, padding * 0.44, pos);
          ctx.fillText(rowNum, cssSize - padding * 0.44, pos);
        }

        const isStudy = state.mode === 'study';
        const isMatchLocal = !isStudy && !!appState.spectatorLocalMatch;
        const studyRender = isStudy ? getStudyRenderState() : null;
        const matchSpecRender = isMatchLocal ? getMatchSpectatorRenderState() : null;

        const board = isStudy
          ? studyRender.board
          : isMatchLocal
            ? matchSpecRender.board
            : (state.board || createEmptyBoard(size));
        const stoneR = cellSize * 0.47;

        const moveNumMap = new Map();
        const branch = isStudy ? studyRender.branch : null;
        const offset = isStudy && branch ? (branch.rezeroOffset || 0) : 0;
        const movesList = isStudy
          ? studyRender.moves
          : isMatchLocal
            ? matchSpecRender.moves
            : (state.moves || []);
        movesList.forEach((m, idx) => {
          if (!m.pass && m.x >= 0 && m.y >= 0 && idx >= offset) {
            moveNumMap.set(`${m.x},${m.y}`, idx - offset + 1);
          }
        });

        const showNum = isStudy ? true : appState.showMoveNumbers;

        // 7. 立體黑白棋子繪製
        for (let y = 0; y < size; y++) {
          for (let x = 0; x < size; x++) {
            const val = board[y][x];
            if (!val) continue;
            const cx = padding + x * cellSize;
            const cy = padding + y * cellSize;

            ctx.beginPath();
            ctx.arc(cx + stoneR * 0.08, cy + stoneR * 0.11, stoneR * 0.99, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(32, 18, 4, 0.34)';
            ctx.fill();

            const sGrad = ctx.createRadialGradient(
              cx - stoneR * 0.32,
              cy - stoneR * 0.32,
              stoneR * 0.08,
              cx,
              cy,
              stoneR
            );
            if (val === 1) {
              sGrad.addColorStop(0, '#5a5a63');
              sGrad.addColorStop(0.32, '#27272a');
              sGrad.addColorStop(0.85, '#111113');
              sGrad.addColorStop(1, '#050506');
            } else {
              sGrad.addColorStop(0, '#ffffff');
              sGrad.addColorStop(0.68, '#f8f7f4');
              sGrad.addColorStop(0.92, '#e4e2dc');
              sGrad.addColorStop(1, '#cbc8bf');
            }
            ctx.beginPath();
            ctx.arc(cx, cy, stoneR, 0, Math.PI * 2);
            ctx.fillStyle = sGrad;
            ctx.fill();

            if (val === 2) {
              ctx.lineWidth = 0.85;
              ctx.strokeStyle = 'rgba(120, 113, 108, 0.45)';
              ctx.stroke();
            }

            const num = moveNumMap.get(`${x},${y}`);
            if (showNum && num) {
              ctx.fillStyle = val === 1 ? '#fafafa' : '#18181b';
              ctx.font = `700 ${Math.max(8, Math.floor(stoneR * 0.84))}px -apple-system, BlinkMacSystemFont, sans-serif`;
              ctx.textAlign = 'center';
              ctx.textBaseline = 'middle';
              ctx.fillText(String(num), cx, cy + 0.5);
            }
          }
        }

        // 8. 最後一手標記（不遮擋手數）
        const lastMove = [...movesList].reverse().find((m) => !m.pass && m.x >= 0 && m.y >= 0);
        if (lastMove && board[lastMove.y] && board[lastMove.y][lastMove.x] !== 0) {
          const lx = padding + lastMove.x * cellSize;
          const ly = padding + lastMove.y * cellSize;
          ctx.beginPath();
          const markerRadius = showNum ? stoneR * 0.82 : stoneR * 0.48;
          ctx.arc(lx, ly, markerRadius, 0, Math.PI * 2);
          ctx.strokeStyle = '#ef4444';
          ctx.lineWidth = Math.max(1.8, stoneR * 0.14);
          ctx.stroke();
        }

        // 9. 雙人對弈預選落子半透明指示（僅實況模式顯示）
        if (state.mode === 'match' && !appState.spectatorLocalMatch && appState.pendingMove) {
          const { x, y } = appState.pendingMove;
          const px = padding + x * cellSize;
          const py = padding + y * cellSize;
          const myRole = getMyRole();
          ctx.save();
          ctx.beginPath();
          ctx.arc(px, py, stoneR * 0.92, 0, Math.PI * 2);
          ctx.fillStyle = myRole === 'B' ? 'rgba(24, 24, 27, 0.55)' : 'rgba(255, 255, 255, 0.72)';
          ctx.fill();
          ctx.setLineDash([4, 3]);
          ctx.strokeStyle = '#10b981';
          ctx.lineWidth = 2.2;
          ctx.stroke();
          ctx.restore();
        }
      }

      function getStarPoints(size) {
        if (size === 19) {
          const pts = [3, 9, 15];
          const out = [];
          for (const x of pts) for (const y of pts) out.push([x, y]);
          return out;
        }
        if (size === 13) {
          return [[3, 3], [9, 3], [6, 6], [3, 9], [9, 9]];
        }
        return [[2, 2], [6, 2], [4, 4], [2, 6], [6, 6]];
      }

      let lastBoardTapAt = 0;
      function handleCanvasPointSelection(clientX, clientY) {
        if (!canvas || !state) return;
        const now = Date.now();
        if (now - lastBoardTapAt < 220) return;
        lastBoardTapAt = now;

        const rect = canvas.getBoundingClientRect();
        const scaleX = boardMetrics.cssSize / rect.width;
        const scaleY = boardMetrics.cssSize / rect.height;
        const localX = (clientX - rect.left) * scaleX;
        const localY = (clientY - rect.top) * scaleY;

        const gx = Math.round((localX - boardMetrics.padding) / boardMetrics.cellSize);
        const gy = Math.round((localY - boardMetrics.padding) / boardMetrics.cellSize);
        if (gx < 0 || gy < 0 || gx >= state.boardSize || gy >= state.boardSize) return;

        if (state.mode === 'study') {
          handleStudyBoardTap(gx, gy);
        } else {
          handleMatchBoardTap(gx, gy);
        }
      }

      let touchStartPos = null;
      let touchMoved = false;
      let lastTouchTriggerAt = 0;

      if (canvas) {
        canvas.addEventListener('touchstart', (e) => {
          if (e.touches.length === 1) {
            touchStartPos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
            touchMoved = false;
          } else {
            touchStartPos = null;
            touchMoved = true;
          }
        }, { passive: true });

        canvas.addEventListener('touchmove', (e) => {
          if (!touchStartPos || e.touches.length !== 1) {
            touchMoved = true;
            return;
          }
          const dx = Math.abs(e.touches[0].clientX - touchStartPos.x);
          const dy = Math.abs(e.touches[0].clientY - touchStartPos.y);
          const zoomScale = window.visualViewport ? window.visualViewport.scale : 1;
          const threshold = Math.max(12, 14 / Math.max(1, zoomScale));
          if (dx > threshold || dy > threshold) {
            touchMoved = true;
          }
        }, { passive: true });

        canvas.addEventListener('touchend', (e) => {
          if (touchStartPos && !touchMoved && e.changedTouches.length === 1) {
            lastTouchTriggerAt = Date.now();
            const t = e.changedTouches[0];
            handleCanvasPointSelection(t.clientX, t.clientY);
          }
          touchStartPos = null;
          touchMoved = false;
        }, { passive: true });

        canvas.addEventListener('touchcancel', () => {
          touchStartPos = null;
          touchMoved = false;
        }, { passive: true });

        canvas.addEventListener('click', (e) => {
          if (e.detail > 1) return;
          if (Date.now() - lastTouchTriggerAt < 800) return;
          handleCanvasPointSelection(e.clientX, e.clientY);
        });
      }

