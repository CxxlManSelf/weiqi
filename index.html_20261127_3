                return;
              }
              safeSetStorage(STORAGE_KEYS.PUBLIC_BASE_URL, parsed.toString(), true);
              parsed.searchParams.set('room', roomKey);
              parsed.hash = `room=${encodeURIComponent(roomKey)}`;
              copyTextToClipboard(parsed.toString(), `已生成並複製房間超連結！`);
            },
            '設定公開網站分享網址',
            'https://你的網站網址/'
          );
        }
      }

      async function fetchAndJoinRemoteRoomByParam(rawTarget) {
        const target = extractRoomKeyFromInput(rawTarget);
        if (!target) return false;
        if (tryAutoJoinPendingRoom(target)) return true;
        if (!useFirebase) return false;

        try {
          const docData = await cloudGetDoc('rooms', target);
          if (docData) {
            const data = normalizeRoomFromRemote(docData);
            if (data && data.id) {
              appState.rooms[data.id] = data;
              return tryAutoJoinPendingRoom(target);
            }
          }
          const docs = await cloudListDocs('rooms', 200);
          let matchedRoom = null;
          docs.forEach((rawDoc) => {
            const data = normalizeRoomFromRemote(rawDoc);
            if (data && (data.id === target || String(data.code) === target)) {
              matchedRoom = data;
            }
          });
          if (matchedRoom) {
            appState.rooms[matchedRoom.id] = matchedRoom;
            return tryAutoJoinPendingRoom(target);
          }
        } catch (e) {}
        return false;
      }

      function tryAutoJoinPendingRoom(overrideTarget = '') {
        const target = extractRoomKeyFromInput(overrideTarget || appState.pendingAutoJoinRoom);
        if (!target) return false;
        if (state && (state.id === target || String(state.code) === target)) {
          appState.pendingAutoJoinRoom = '';
          return true;
        }
        const roomsList = Object.values(appState.rooms || {});
        const matched = roomsList.find(
          (r) => r && (r.id === target || String(r.code) === target)
        );
        if (matched) {
          appState.pendingAutoJoinRoom = '';
          enterRoom(matched.id);
          showToast(`已透過連結自動進入房間 #${matched.code || ''}`);
          return true;
        }
        return false;
      }

      // ==================== 5. 遊戲大廳與 300 則大廳聊天室 ====================
      function getRoomOnlineCount(room) {
        if (!room || !room.id) return 0;
        const now = Date.now();
        const activeUids = new Set();

        if (room.activeMembers && typeof room.activeMembers === 'object') {
          Object.entries(room.activeMembers).forEach(([uid, info]) => {
            const ts = typeof info === 'number' ? info : info && typeof info.lastSeenAt === 'number' ? info.lastSeenAt : 0;
            if (uid && ts && now - ts <= MEMBER_STALE_MS) {
              activeUids.add(uid);
            }
          });
        }

        if (state && state.id === room.id) {
          activeUids.add(getMyUid());
        }

        return activeUids.size;
      }

      // ==================== 5.1 我的對戰房間統計、角標與慢棋清單 ====================
      function getRoomRemainingTimeInfo(room, color) {
        if (!room || (room.mainTime === 0 && room.byoyomiSeconds === 0)) {
          return { label: '無限', sortSeconds: Number.MAX_SAFE_INTEGER };
        }
        const rawClock = room.clocks && room.clocks[color]
          ? { ...room.clocks[color] }
          : { main: room.mainTime || 0, byoLeft: room.byoyomiSeconds || 0, periodsLeft: room.byoyomiPeriods || 0, inByo: false };

        const isRunning = room.status === 'playing' && room.turn === color && !!room.blackUid && !!room.whiteUid;
        const elapsed = isRunning ? Math.max(0, (Date.now() - (room.lastTickAt || Date.now())) / 1000) : 0;

        if (!rawClock.inByo) {
          if (rawClock.main > elapsed) {
            const rem = rawClock.main - elapsed;
            return { label: `剩 ${formatSeconds(rem)}`, sortSeconds: rem };
          }
          const overflow = elapsed - rawClock.main;
          if (!room.byoyomiSeconds || !room.byoyomiPeriods) {
            return { label: '已超時', sortSeconds: 0 };
          }
          const used = Math.floor(overflow / room.byoyomiSeconds);
          if (used >= rawClock.periodsLeft) {
            return { label: '已超時', sortSeconds: 0 };
          }
          const remByo = room.byoyomiSeconds - (overflow % room.byoyomiSeconds);
          const remPeriods = rawClock.periodsLeft - used;
          return {
            label: `讀秒 ${formatSeconds(remByo)} (${remPeriods}次)`,
            sortSeconds: remByo + (remPeriods - 1) * room.byoyomiSeconds
          };
        } else {
          if (!room.byoyomiSeconds || !room.byoyomiPeriods) {
            return { label: '已超時', sortSeconds: 0 };
          }
          const used = Math.floor(elapsed / room.byoyomiSeconds);
          if (used >= rawClock.periodsLeft) {
            return { label: '已超時', sortSeconds: 0 };
          }
          const remByo = room.byoyomiSeconds - (elapsed % room.byoyomiSeconds);
          const remPeriods = rawClock.periodsLeft - used;
          return {
            label: `讀秒 ${formatSeconds(remByo)} (${remPeriods}次)`,
            sortSeconds: remByo + (remPeriods - 1) * room.byoyomiSeconds
          };
        }
      }

      function getMyMatchRooms() {
        const myUid = getMyUid();
        const myVault = getMyVaultCode();
        const now = Date.now();
        const combinedMap = { ...(appState.rooms || {}) };
        if (state && state.id && !state.deleted && !appState.deletedRoomIds.has(state.id)) {
          combinedMap[state.id] = state;
        }

        const items = [];
        Object.values(combinedMap).forEach((r) => {
          if (!r || r.mode !== 'match' || r.deleted || appState.deletedRoomIds.has(r.id)) return;
          const isBlack = r.blackUid === myUid || (r.blackVaultCode && myVault && r.blackVaultCode === myVault);
          const isWhite = r.whiteUid === myUid || (r.whiteVaultCode && myVault && r.whiteVaultCode === myVault);
          if (!isBlack && !isWhite) return;

          const myColor = isBlack ? 'B' : 'W';
          const lastAct = r.lastActivityAt || r.createdAt || now;
          if (r.status === 'finished' && now - lastAct > 7 * DAY_24_MS) return;

          let category = 'opp_turn';
          let priority = 2;
          if (r.status === 'finished') {
            category = 'finished';
            priority = 4;
          } else if (!r.blackUid || !r.whiteUid || r.status === 'waiting') {
            category = 'waiting_seat';
            priority = 3;
          } else if (r.turn === myColor) {
            category = 'my_turn';
            priority = 1;
          } else {
            category = 'opp_turn';
            priority = 2;
          }

          const clockInfo = getRoomRemainingTimeInfo(r, myColor);
          items.push({
            room: r,
            myColor,
            category,
            priority,
            clockInfo,
            lastAct
          });
        });

        items.sort((a, b) => {
          if (a.priority !== b.priority) return a.priority - b.priority;
          if (a.category === 'my_turn' && a.clockInfo.sortSeconds !== b.clockInfo.sortSeconds) {
            return a.clockInfo.sortSeconds - b.clockInfo.sortSeconds;
          }
          return b.lastAct - a.lastAct;
        });

        return items;
      }

