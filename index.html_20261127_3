  <div id="toast-container" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 pointer-events-none flex flex-col items-center gap-1.5"></div>

  <script>
    (() => {
      'use strict';

      // ==================== 0. 獨立雲端 Firebase Realtime Database 預設連線設定 ====================
      const DEFAULT_EXTERNAL_FIREBASE_CONFIG = {
        apiKey: "AIzaSyC213Jd7mA5ViTnwkAH0Pm_-dCnjZPyXms",
        authDomain: "my-go-a276e.firebaseapp.com",
        databaseURL: "https://my-go-a276e-default-rtdb.firebaseio.com",
        projectId: "my-go-a276e",
        storageBucket: "my-go-a276e.firebasestorage.app",
        messagingSenderId: "1045233117985",
        appId: "1:1045233117985:web:af1c7956ae63ee72d8ec60",
        measurementId: "G-4XW285PRPM"
      };

      // ==================== 1. 個人身分、雲端識別碼與安全儲存（僅存個人設定，不快取房間） ====================
      const STORAGE_KEYS = {
        UID: 'weiqi_uid_v2',
        NICKNAME: 'weiqi_nickname_v2',
        IDENTITY: 'weiqi_identity_bundle_v2',
        VAULT_CODE: 'weiqi_vault_code_v1',
        VAULT_STATS: 'weiqi_vault_stats_v1',
        LOCAL_VAULT_RECORDS: 'weiqi_local_vault_records_v1',
        PUBLIC_BASE_URL: 'weiqi_public_base_url_v1'
      };

      const DAY_24_MS = 24 * 60 * 60 * 1000;
      const MAX_LOBBY_CHAT = 300;
      const COLS_STR = 'ABCDEFGHJKLMNOPQRST'; // 圍棋座標跳過 I
      const MEMBER_STALE_MS = 12 * 60 * 60 * 1000; // 搭配 RTDB onDisconnect 自動離線清除

      const memoryStorage = {};
      const WINDOW_NAME_PREFIX = '__WEIQI_STATE_V2__:';
      let isBootHydrated = false;
      let hasExplicitPersistedUid = false;
      let hasExplicitPersistedNickname = false;
      let isFreshlyGeneratedUid = false;
      let isFreshlyGeneratedVaultCode = false;
      let needsCloudRegisterNewCharacter = false;
      let fallbackSessionNickname = '';

      // 舊版本地房間快取鍵值（啟動時主動清除，確保完全不使用本地房間快取）
      const LEGACY_ROOM_CACHE_KEYS = ['weiqi_rooms_v2', 'weiqi_lobby_chat_v2'];

      function purgeLegacyRoomCaches() {
        LEGACY_ROOM_CACHE_KEYS.forEach((k) => {
          try { window.localStorage.removeItem(k); } catch (e) {}
          try { window.sessionStorage.removeItem(k); } catch (e) {}
          deleteFromIndexedDb(k);
        });
        try {
          const toDelLocal = [];
          for (let i = 0; i < window.localStorage.length; i++) {
            const key = window.localStorage.key(i);
            if (key && (key.startsWith('weiqi_room_chat_') || key.startsWith('weiqi_room_members_') || key.startsWith('weiqi_rooms'))) {
              toDelLocal.push(key);
            }
          }
          toDelLocal.forEach((k) => window.localStorage.removeItem(k));
        } catch (e) {}
        try {
          const toDelSess = [];
          for (let i = 0; i < window.sessionStorage.length; i++) {
            const key = window.sessionStorage.key(i);
            if (key && (key.startsWith('weiqi_room_chat_') || key.startsWith('weiqi_room_members_') || key.startsWith('weiqi_rooms'))) {
              toDelSess.push(key);
            }
          }
          toDelSess.forEach((k) => window.sessionStorage.removeItem(k));
        } catch (e) {}
      }

      function readWindowNameStore() {
        try {
          if (typeof window.name === 'string' && window.name.startsWith(WINDOW_NAME_PREFIX)) {
            return JSON.parse(window.name.slice(WINDOW_NAME_PREFIX.length)) || {};
          }
        } catch (e) {}
        return {};
      }

      function writeWindowNameStore(obj) {
        try {
          window.name = WINDOW_NAME_PREFIX + JSON.stringify(obj);
        } catch (e) {}
      }

      function readCookieValue(key) {
        try {
          const prefix = encodeURIComponent(key) + '=';
          const parts = document.cookie ? document.cookie.split(';') : [];
          for (const part of parts) {
            const trimmed = part.trim();
            if (trimmed.startsWith(prefix)) {
              return decodeURIComponent(trimmed.slice(prefix.length));
            }
          }
        } catch (e) {}
        return null;
      }

      function writeCookieValue(key, value) {
        const encoded = `${encodeURIComponent(key)}=${encodeURIComponent(value)}; max-age=31536000; path=/`;
        try {
          if (window.location.protocol === 'https:') {
            document.cookie = `${encoded}; SameSite=None; Secure`;
          }
          document.cookie = `${encoded}; SameSite=Lax`;
        } catch (e) {}
      }

      function openIdentityDb() {
        return new Promise((resolve) => {
          try {
            if (!window.indexedDB) {
              resolve(null);
              return;
            }
            const req = window.indexedDB.open('weiqi_identity_db', 1);
            req.onupgradeneeded = (ev) => {
              const idb = ev.target.result;
              if (!idb.objectStoreNames.contains('kv_store')) {
                idb.createObjectStore('kv_store');
              }
            };
            req.onsuccess = () => resolve(req.result);
            req.onerror = () => resolve(null);
          } catch (e) {
            resolve(null);
          }
        });
      }

      function saveToIndexedDb(key, value) {
        openIdentityDb().then((idb) => {
          if (!idb) return;
          try {
            const tx = idb.transaction('kv_store', 'readwrite');
            tx.objectStore('kv_store').put(value, key);
          } catch (e) {}
        });
      }

      function deleteFromIndexedDb(key) {
        openIdentityDb().then((idb) => {
          if (!idb) return;
          try {
            const tx = idb.transaction('kv_store', 'readwrite');
            tx.objectStore('kv_store').delete(key);
          } catch (e) {}
        });
      }

      function loadAllFromIndexedDb() {
        return openIdentityDb().then((idb) => {
          if (!idb) return {};
          return new Promise((resolve) => {
            try {
              const tx = idb.transaction('kv_store', 'readonly');
              const store = tx.objectStore('kv_store');
              const keysToRead = [
                STORAGE_KEYS.UID,
                STORAGE_KEYS.NICKNAME,
                STORAGE_KEYS.IDENTITY,
                STORAGE_KEYS.VAULT_CODE,
                STORAGE_KEYS.VAULT_STATS,
                STORAGE_KEYS.LOCAL_VAULT_RECORDS,
                STORAGE_KEYS.PUBLIC_BASE_URL
              ];
              const result = {};
              let remaining = keysToRead.length;
              keysToRead.forEach((k) => {
                const r = store.get(k);
                r.onsuccess = () => {
                  if (r.result !== undefined && r.result !== null) {
                    result[k] = r.result;
                  }
                  remaining--;
                  if (remaining === 0) resolve(result);
                };
                r.onerror = () => {
                  remaining--;
                  if (remaining === 0) resolve(result);
                };
              });
            } catch (e) {
              resolve({});
            }
          });
        });
      }

      function safeGetStorage(key) {
        if (memoryStorage[key] !== undefined && memoryStorage[key] !== null) {
          return memoryStorage[key];
        }
        try {
          const val = window.localStorage.getItem(key);
          if (val !== null) {
            memoryStorage[key] = val;
            return val;
          }
        } catch (e) {}
        try {
          const sVal = window.sessionStorage.getItem(key);
          if (sVal !== null) {
            memoryStorage[key] = sVal;
            return sVal;
          }
        } catch (e) {}
        const wn = readWindowNameStore();
        if (wn[key] !== undefined && wn[key] !== null) {
          memoryStorage[key] = wn[key];
          return wn[key];
        }
        const cVal = readCookieValue(key);
        if (cVal !== null) {
          memoryStorage[key] = cVal;
          return cVal;
        }
        return null;
      }

      function safeSetStorage(key, value, writeToIdb = true) {
        memoryStorage[key] = value;
        try {
          window.localStorage.setItem(key, value);
        } catch (e) {}
        try {
          window.sessionStorage.setItem(key, value);
        } catch (e) {}
        if (
          key === STORAGE_KEYS.UID ||
          key === STORAGE_KEYS.NICKNAME ||
          key === STORAGE_KEYS.IDENTITY ||
          key === STORAGE_KEYS.VAULT_CODE ||
          key === STORAGE_KEYS.VAULT_STATS ||
          key === STORAGE_KEYS.PUBLIC_BASE_URL
        ) {
          const wn = readWindowNameStore();
          wn[key] = value;
          writeWindowNameStore(wn);
          writeCookieValue(key, value);
        }
        if (writeToIdb) {
          saveToIndexedDb(key, value);
        }
      }

      function simpleStableHash(input) {
        const str = String(input || '');
        let h1 = 0xdeadbeef;
        let h2 = 0x41c6ce57;
        for (let i = 0; i < str.length; i++) {
          const ch = str.charCodeAt(i);
          h1 = Math.imul(h1 ^ ch, 2654435761);
          h2 = Math.imul(h2 ^ ch, 1597334677);
        }
        h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
        h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
        return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(36);
      }

      function normalizeVaultCode(raw) {
        const trimmed = String(raw || '').trim();
        if (!trimmed) return '';
        const cleaned = trimmed
          .replace(/[\\/\s]+/g, '-')
          .replace(/[^a-zA-Z0-9\u4e00-\u9fa5_@.-]/g, '')
          .slice(0, 36);
        if (cleaned.length < 2) return '';
        return /^[a-zA-Z0-9_@.-]+$/.test(cleaned) ? cleaned.toUpperCase() : cleaned;
      }

      // 將 Gmail 信箱或自訂識別碼中的「.」等字元轉為 Firebase Realtime Database 合法路徑鍵名
      function encodeRtdbKey(rawKey) {
        return String(rawKey || '')
          .replace(/\./g, '_DOT_')
          .replace(/#/g, '_HASH_')
          .replace(/\$/g, '_DOL_')
          .replace(/\[/g, '_LB_')
          .replace(/\]/g, '_RB_')
          .replace(/\//g, '_SL_');
      }

      function generateVaultCode() {
        const words = ['KAYA', 'STAR', 'TENGEN', 'HANE', 'ATARI', 'SENTE', 'JOSEKI', 'KO', 'DAME', 'GOBAN'];
        const num = Math.floor(1000 + Math.random() * 9000);
        const w = words[Math.floor(Math.random() * words.length)];
        return `WQ-${num}-${w}`;
      }

      function generateNewGuestNickname(excludeName = '') {
        let candidate = '';
        for (let i = 0; i < 10; i++) {
          const suffix = Math.floor(1000 + Math.random() * 9000);
          candidate = `棋友_${suffix}`;
          if (candidate !== excludeName) break;
        }
        return candidate;
      }

      function deriveDeterministicAccountUid(vaultCode, pin = '') {
        const seed = `weiqi_acct_v1:${vaultCode}:${pin || ''}`;
        return `acct_${simpleStableHash(seed)}_${simpleStableHash(seed + '_salt')}`;
      }

      function getMyVaultCode() {
        const stored = normalizeVaultCode(safeGetStorage(STORAGE_KEYS.VAULT_CODE));
        if (stored) return stored;
        const fresh = generateVaultCode();
        isFreshlyGeneratedVaultCode = true;
        if (isBootHydrated) {
          safeSetStorage(STORAGE_KEYS.VAULT_CODE, fresh, true);
        } else {
          memoryStorage[STORAGE_KEYS.VAULT_CODE] = fresh;
        }
        return fresh;
      }

      // ==================== 識別碼戰績（勝次數、敗次數）管理與雲端同步 ====================
      let vaultProfileUnsubscribe = null;

      function getLocalVaultStatsMap() {
        try {
          const raw = safeGetStorage(STORAGE_KEYS.VAULT_STATS);
          const parsed = raw ? JSON.parse(raw) : {};
          return parsed && typeof parsed === 'object' ? parsed : {};
        } catch (e) {
          return {};
        }
      }

      function saveLocalVaultStatsForCode(vaultCode, wins, losses) {
        const code = normalizeVaultCode(vaultCode);
        if (!code) return;
        const map = getLocalVaultStatsMap();
        map[code] = {
          wins: Math.max(0, Math.floor(Number(wins) || 0)),
          losses: Math.max(0, Math.floor(Number(losses) || 0)),
          updatedAt: Date.now()
        };
        try {
          safeSetStorage(STORAGE_KEYS.VAULT_STATS, JSON.stringify(map), true);
        } catch (e) {}
      }

      function getVaultStats(vaultCode) {
        const code = normalizeVaultCode(vaultCode || getMyVaultCode());
        if (!code) return { wins: 0, losses: 0 };
        const cloudProf = appState.vaultProfiles && appState.vaultProfiles[code];
        const localProf = getLocalVaultStatsMap()[code];
        const wins = Math.max(
          0,
          Math.floor(Number(cloudProf?.wins ?? localProf?.wins ?? 0) || 0)
        );
        const losses = Math.max(
          0,
          Math.floor(Number(cloudProf?.losses ?? localProf?.losses ?? 0) || 0)
        );
        return { wins, losses };
      }

      function subscribeVaultProfileStats(vaultCode) {
        const code = normalizeVaultCode(vaultCode || getMyVaultCode());
        if (vaultProfileUnsubscribe) {
          vaultProfileUnsubscribe();
          vaultProfileUnsubscribe = null;
        }
        updateVaultAndCloudStatusUI();
        if (!useFirebase || !code) return;

        vaultProfileUnsubscribe = cloudSubscribeDoc(
          'vault_profiles',
          encodeRtdbKey(code),
          (d) => {
            if (!d) return;
            const wins = Math.max(0, Math.floor(Number(d.wins) || 0));
            const losses = Math.max(0, Math.floor(Number(d.losses) || 0));
            appState.vaultProfiles[code] = {
              ...(appState.vaultProfiles[code] || {}),
              ...d,
              wins,
              losses
            };
            saveLocalVaultStatsForCode(code, wins, losses);
            updateVaultAndCloudStatusUI();
            if (state && state.mode === 'match') {
              updateMatchPanelUI();
            }
          },
          () => {}
        );
      }

      async function recordVaultMatchOutcome(vaultCode, isWin, fallbackName = '') {
        const code = normalizeVaultCode(vaultCode);
        if (!code) return;

        const curLocal = getVaultStats(code);
        const nextLocalWins = curLocal.wins + (isWin ? 1 : 0);
        const nextLocalLosses = curLocal.losses + (isWin ? 0 : 1);
        saveLocalVaultStatsForCode(code, nextLocalWins, nextLocalLosses);
        appState.vaultProfiles[code] = {
          ...(appState.vaultProfiles[code] || {}),
          vaultCode: code,
          wins: nextLocalWins,
          losses: nextLocalLosses,
          updatedAt: Date.now()
        };

        if (useFirebase && rtdb) {
          const docRef = getCloudRef(`vault_profiles/${encodeRtdbKey(code)}`);
          try {
            await docRef.transaction((existing) => {
              const cur = existing && typeof existing === 'object' ? existing : {};
              const baseWins = Math.max(0, Math.floor(Number(cur.wins) || 0));
              const baseLosses = Math.max(0, Math.floor(Number(cur.losses) || 0));
              const payload = {
                ...cur,
                vaultCode: code,
                wins: baseWins + (isWin ? 1 : 0),
                losses: baseLosses + (isWin ? 0 : 1),
                updatedAt: Date.now()
              };
              if (!cur.nickname && fallbackName) {
                payload.nickname = fallbackName;
              }
              return payload;
            });
          } catch (e) {}
        }
        updateVaultAndCloudStatusUI();
      }

      function settleFinishedMatchVaultStats() {
        if (!state || state.mode !== 'match' || state.status !== 'finished' || !state.result) return;
        if (state.statsRecorded) return;
        const winner = state.result.winner;
        if (winner !== 'B' && winner !== 'W') return;

        state.statsRecorded = true;
        const bVault = normalizeVaultCode(state.blackVaultCode);
        const wVault = normalizeVaultCode(state.whiteVaultCode);

        if (bVault) {
          recordVaultMatchOutcome(bVault, winner === 'B', state.blackName || '');
        }
        if (wVault && wVault !== bVault) {
          recordVaultMatchOutcome(wVault, winner === 'W', state.whiteName || '');
        }
      }

      function syncVaultProfileToCloud(vaultCode, uid, nickname, pinHash = null) {
        if (!useFirebase || !vaultCode || !uid) return;
        const safeKey = encodeRtdbKey(vaultCode);
        const localStats = getVaultStats(vaultCode);
        const payload = {
          vaultCode,
          uid,
          nickname: nickname || getMyNickname(),
          wins: localStats.wins,
          losses: localStats.losses,
          updatedAt: Date.now()
        };
        if (pinHash !== null) {
          payload.pinHash = pinHash;
        }
        cloudGetDoc('vault_profiles', safeKey)
          .then((ex) => {
            if (ex) {
              payload.wins = Math.max(localStats.wins, Math.floor(Number(ex.wins) || 0));
              payload.losses = Math.max(localStats.losses, Math.floor(Number(ex.losses) || 0));
            }
            return cloudSetDoc('vault_profiles', safeKey, payload, { merge: true });
          })
          .catch(() => {});
      }

      function isDefaultGuestNickname(name) {
        return !name || /^棋友_\d{4}$/.test(String(name).trim());
      }

      function isRoomHost(room) {
        if (!room) return false;
        const myUid = getMyUid();
        const myVault = getMyVaultCode();
        const myNick = String(getMyNickname() || '').trim();
        if (room.hostUid && room.hostUid === myUid) return true;
        if (room.hostVaultCode && myVault && room.hostVaultCode === myVault) return true;
        if (!isDefaultGuestNickname(myNick) && room.hostName && room.hostName === myNick) return true;
        return false;
      }

      function reclaimMatchingRolesAcrossRooms(targetUid, targetNickname, targetVaultCode = '') {
        const myUid = targetUid || getMyUid();
        const myVault = normalizeVaultCode(targetVaultCode || getMyVaultCode());
        const myNick = String(targetNickname || getMyNickname() || '').trim();
        const canMatchByNick = !isDefaultGuestNickname(myNick);
        let reclaimedCount = 0;

        const syncSingleRoomOwnership = (r) => {
          if (!r) return false;
          let changed = false;

          const matchHost =
            (myVault && r.hostVaultCode === myVault) ||
            (r.hostUid === myUid);
          if (matchHost) {
            if (r.hostUid !== myUid) { r.hostUid = myUid; changed = true; }
            if (myVault && r.hostVaultCode !== myVault) { r.hostVaultCode = myVault; changed = true; }
            if (canMatchByNick && r.hostName !== myNick) { r.hostName = myNick; changed = true; }
          }

          const matchBlack =
            (myVault && r.blackVaultCode === myVault) ||
            (r.blackUid === myUid);
          if (matchBlack) {
            if (r.blackUid !== myUid) { r.blackUid = myUid; changed = true; }
            if (myVault && r.blackVaultCode !== myVault) { r.blackVaultCode = myVault; changed = true; }
            if (canMatchByNick && r.blackName !== myNick) { r.blackName = myNick; changed = true; }
          }

          const matchWhite =
            (myVault && r.whiteVaultCode === myVault) ||
            (r.whiteUid === myUid);
          if (matchWhite) {
            if (r.whiteUid !== myUid) { r.whiteUid = myUid; changed = true; }
            if (myVault && r.whiteVaultCode !== myVault) { r.whiteVaultCode = myVault; changed = true; }
            if (canMatchByNick && r.whiteName !== myNick) { r.whiteName = myNick; changed = true; }
          }

          const matchPresenter =
            (myVault && r.studyControllerVaultCode === myVault) ||
            (r.studyControllerUid === myUid);
          if (matchPresenter) {
            if (r.studyControllerUid !== myUid) { r.studyControllerUid = myUid; changed = true; }
            if (myVault && r.studyControllerVaultCode !== myVault) { r.studyControllerVaultCode = myVault; changed = true; }
            if (canMatchByNick && r.studyControllerName !== myNick) { r.studyControllerName = myNick; changed = true; }
          }

          return changed;
        };

        Object.values(appState.rooms || {}).forEach((r) => {
          if (syncSingleRoomOwnership(r)) {
            reclaimedCount++;
            if (useFirebase) {
              cloudSetDoc('rooms', r.id, serializeRoomForFirestore(r), { merge: true }).catch(() => {});
            }
          }
        });

        if (state && syncSingleRoomOwnership(state)) {
          reclaimedCount++;
          updateMyRoomPresence(state.id, true);
          persistCurrentRoomAndSync(false);
          updateAllRoomUI();
        }
        return reclaimedCount;
      }

      async function checkVaultCodeExistsInCloud(normCode) {
        if (!normCode) return { exists: false, profile: null };

        if (appState.vaultProfiles && appState.vaultProfiles[normCode]) {
          return { exists: true, profile: appState.vaultProfiles[normCode] };
        }

        if (useFirebase) {
          const prof = await cloudGetDoc('vault_profiles', encodeRtdbKey(normCode));
          if (prof) {
            appState.vaultProfiles[normCode] = prof;
            return { exists: true, profile: prof };
          }
        }

        const localStats = getLocalVaultStatsMap()[normCode];
        const localRecs = loadLocalVaultRecordsForCode(normCode);
        if (localStats || (localRecs && localRecs.length > 0)) {
          return { exists: true, profile: null };
        }

        return { exists: false, profile: null };
      }

      async function switchCharacterByVaultCode(rawCode, rawPin = '') {
        const norm = normalizeVaultCode(rawCode);
        if (!norm) {
          showToast('識別碼格式不符（請輸入 2～36 碼英數字、代號或信箱）');
          return false;
        }

        if (!useFirebase) {
          const connected = await ensureFirebaseConnected();
          if (!connected) {
            showToast('⚠️ Firebase 尚未連線，無法驗證雲端識別碼');
            return false;
          }
        }

        const pin = String(rawPin || '').trim();
        const enteredPinHash = pin ? simpleStableHash(`${norm}#${pin}`) : '';
        let exists = false;
        let cloudProf = null;

        if (norm === getMyVaultCode()) {
          exists = true;
          cloudProf = (appState.vaultProfiles && appState.vaultProfiles[norm]) || {
            vaultCode: norm,
            uid: getMyUid(),
            nickname: getMyNickname()
          };
        } else {
          try {
            const checkRes = await checkVaultCodeExistsInCloud(norm);
            exists = checkRes.exists;
            cloudProf = checkRes.profile;
          } catch (err) {
            showToast(`⚠️ 查詢雲端識別碼失敗：${formatFirebaseError(err)}`);
            return false;
          }
        }

        if (exists) {
          if (cloudProf && cloudProf.pinHash) {
            if (!enteredPinHash || cloudProf.pinHash !== enteredPinHash) {
              showToast('🔒 此角色識別碼設有安全 PIN 碼，請在右側輸入正確 PIN 碼！', 3600);
              return false;
            }
          }

          const targetUid = (cloudProf && cloudProf.uid) || deriveDeterministicAccountUid(norm, pin);
          const targetNick = (cloudProf && cloudProf.nickname) || generateNewGuestNickname(getMyNickname());

          isFreshlyGeneratedVaultCode = false;
          hasExplicitPersistedUid = true;
          hasExplicitPersistedNickname = true;
          safeSetStorage(STORAGE_KEYS.VAULT_CODE, norm, true);
          safeSetStorage(STORAGE_KEYS.UID, targetUid, true);
          safeSetStorage(STORAGE_KEYS.NICKNAME, targetNick, true);
          persistIdentityBundle(targetUid, targetNick, true);
          setMyNickname(targetNick, true);
          updateVaultAndCloudStatusUI();

          reclaimMatchingRolesAcrossRooms(targetUid, targetNick, norm);
          syncVaultProfileToCloud(norm, targetUid, targetNick, cloudProf?.pinHash || enteredPinHash || '');

          loadVaultRecordsForCode(norm);
          subscribeVaultProfileStats(norm);
          renderLobbyRooms();
          if (state) {
            updateMyRoomPresence(state.id, true);
            updateAllRoomUI();
          }
          showToast(`✅ 已切換為角色「${targetNick}」（識別碼：${norm}）`);
          return true;
        } else {
          const prevNick = getMyNickname();
          const newUid = deriveDeterministicAccountUid(norm, pin);
          const freshNick = generateNewGuestNickname(prevNick);

          isFreshlyGeneratedVaultCode = false;
          hasExplicitPersistedUid = true;
          hasExplicitPersistedNickname = true;
          safeSetStorage(STORAGE_KEYS.VAULT_CODE, norm, true);
          safeSetStorage(STORAGE_KEYS.UID, newUid, true);
          safeSetStorage(STORAGE_KEYS.NICKNAME, freshNick, true);
          persistIdentityBundle(newUid, freshNick, true);
          setMyNickname(freshNick, true);
          updateVaultAndCloudStatusUI();

          syncVaultProfileToCloud(norm, newUid, freshNick, enteredPinHash);
          loadVaultRecordsForCode(norm);
          subscribeVaultProfileStats(norm);
          renderLobbyRooms();
          if (state) {
            updateMyRoomPresence(state.id, true);
            updateAllRoomUI();
          }
          showToast(`🆕 識別碼「${norm}」不存在，已用此識別碼建立新角色「${freshNick}」！`, 3600);
          return true;
        }
      }

      async function setMyVaultCode(rawCode, shouldLoadRecords = true, restoreIdentityFromCloud = true, rawPin = '') {
        const norm = normalizeVaultCode(rawCode);
        if (!norm) {
          showToast('帳號格式不符（請輸入 2～36 碼 Gmail、中文、英數字）');
          return false;
        }
        const pin = String(rawPin || '').trim();
        const enteredPinHash = pin ? simpleStableHash(`${norm}#${pin}`) : '';
        const deterministicUid = deriveDeterministicAccountUid(norm, pin);

        let cloudProf = null;
        if (restoreIdentityFromCloud && useFirebase) {
          try {
            cloudProf = await cloudGetDoc('vault_profiles', encodeRtdbKey(norm));
          } catch (e) {}
        }

        if (cloudProf && cloudProf.pinHash) {
          if (!enteredPinHash || cloudProf.pinHash !== enteredPinHash) {
            showToast('🔒 此帳號設有安全 PIN 碼，請在右側輸入正確 PIN 碼！', 3600);
            return false;
          }
        }

        isFreshlyGeneratedVaultCode = false;
        safeSetStorage(STORAGE_KEYS.VAULT_CODE, norm, true);
        updateVaultAndCloudStatusUI();

        const targetUid = (cloudProf && cloudProf.uid) || deterministicUid;
        const guessedNickFromAcct = !hasExplicitPersistedNickname && !norm.includes('@') && !/^WQ-\d{4}-/.test(norm)
          ? norm.slice(0, 16)
          : null;
        const targetNick = (cloudProf && cloudProf.nickname) || guessedNickFromAcct || (hasExplicitPersistedNickname ? getMyNickname() : null);

        adoptPersistedIdentity(targetUid, targetNick, !!targetNick);
        if (targetNick) {
          setMyNickname(targetNick, true);
        }

        const effectiveNick = getMyNickname();
        reclaimMatchingRolesAcrossRooms(getMyUid(), effectiveNick, norm);

        if (useFirebase) {
          syncVaultProfileToCloud(norm, getMyUid(), effectiveNick, cloudProf?.pinHash || enteredPinHash || '');
        }

        if (shouldLoadRecords) {
          loadVaultRecordsForCode(norm);
          subscribeVaultProfileStats(norm);
        }
        return true;
      }

      function promptSwitchVaultCode() {
        openNicknameSettingsModal();
        setTimeout(() => {
          const inp = document.getElementById('modal-vault-code-input');
          inp?.focus();
          inp?.select();
        }, 60);
      }

      function updateVaultAndCloudStatusUI() {
