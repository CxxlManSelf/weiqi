      async function ensureFirebaseConnected() {
        if (useFirebase && rtdb) return true;
        if (initSyncPromise) {
          try {
            await initSyncPromise;
          } catch (e) {}
          if (useFirebase && rtdb) return true;
        }
        await initSyncBackend();
        return !!(useFirebase && rtdb);
      }

      function initSyncBackend() {
        if (initSyncPromise) return initSyncPromise;
        initSyncPromise = runInitSyncBackend().finally(() => {
          initSyncPromise = null;
        });
        return initSyncPromise;
      }

      async function runInitSyncBackend() {
        updateFirebaseStatusUI('connecting');
        updateVaultAndCloudStatusUI();
        recoverNicknameFromKnownData(getMyUid());

        if (roomsCollectionUnsubscribe) { roomsCollectionUnsubscribe(); roomsCollectionUnsubscribe = null; }
        if (lobbyChatUnsubscribe) { lobbyChatUnsubscribe(); lobbyChatUnsubscribe = null; }

        if (typeof navigator !== 'undefined' && navigator.onLine === false) {
          useFirebase = false;
          updateFirebaseStatusUI('error', '目前裝置處於離線狀態，請連線網路後點擊「重新連線」');
          appState.roomsLoadedFromCloud = true;
          renderLobbyRooms();
          return;
        }

        try {
          const { cfg: activeCfg, external: externalMode } = getActiveFirebaseConfig();
          if (!activeCfg || !activeCfg.apiKey || !activeCfg.databaseURL) {
            throw new Error('找不到 Firebase Realtime Database 設定檔 (databaseURL)');
          }
          isExternalFirebase = externalMode;

          if (!firebase.apps.length) {
            firebase.initializeApp(activeCfg);
          }

          if (!networkListenersBound) {
            networkListenersBound = true;
            window.addEventListener('online', () => {
              if (!useFirebase) initSyncBackend();
            });
            window.addEventListener('offline', () => {
              useFirebase = false;
              updateFirebaseStatusUI('error', '網路已中斷，恢復連線後將自動重新連接 RTDB');
            });
          }

          if (firebase.auth) {
            auth = firebase.auth();
            const restoredUser = await new Promise((resolve) => {
              let settled = false;
              const unsub = auth.onAuthStateChanged((u) => {
                if (settled) return;
                settled = true;
                unsub();
                resolve(u || null);
              });
              setTimeout(() => {
                if (!settled) {
                  settled = true;
                  try { unsub(); } catch (e) {}
                  resolve(auth.currentUser || null);
                }
              }, 1500);
            });

            if (restoredUser) {
              currentUser = restoredUser;
            } else {
              try {
                if (externalMode) {
                  const cred = await withTimeout(auth.signInAnonymously(), 5000, 'AUTH_TIMEOUT');
                  currentUser = (cred && cred.user) || auth.currentUser || null;
                } else {
                  let cred = null;
                  if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    cred = await withTimeout(auth.signInWithCustomToken(__initial_auth_token), 5000, 'AUTH_TIMEOUT').catch(() => null);
                  }
                  if (!cred || !cred.user) {
                    cred = await withTimeout(auth.signInAnonymously(), 5000, 'AUTH_TIMEOUT');
                  }
                  currentUser = (cred && cred.user) || auth.currentUser || null;
                }
              } catch (authErr) {
                currentUser = auth.currentUser || null;
              }
            }
          }

          rtdb = firebase.database();
          await withTimeout(getCloudRef('rooms').limitToLast(1).once('value'), 6500, 'CONNECTION_TIMEOUT');

          useFirebase = true;
          updateFirebaseStatusUI('connected');
        } catch (e) {
          useFirebase = false;
          const detail = formatFirebaseError(e);
          updateFirebaseStatusUI('error', detail);
          appState.roomsLoadedFromCloud = true;
          renderLobbyRooms();
          return;
        }

        if (useFirebase) {
          if (currentUser) {
            await handleAuthenticatedUserReady(currentUser);
          }
          const authUid = currentUser ? currentUser.uid : null;

          roomsCollectionUnsubscribe = cloudSubscribeCollection(
            'rooms',
            (docs) => {
              appState.roomsLoadedFromCloud = true;
              updateFirebaseStatusUI('connected');
              let needsOwnershipHeal = false;
              const seenIds = new Set();
              const now = Date.now();

              docs.forEach((rawDoc) => {
                const data = normalizeRoomFromRemote(rawDoc);
                if (!data || !data.id) return;
                if (data.deleted || appState.deletedRoomIds.has(data.id)) {
                  delete appState.rooms[data.id];
                  if (state && state.id === data.id) {
                    handleRemoteRoomDeleted();
                  }
                  return;
                }
                if (isRoomWaitExpired(data, now)) {
                  expireAndRemoveWaitingRoom(data);
                  return;
                }
                seenIds.add(data.id);
                appState.rooms[data.id] = data;
                const myVault = getMyVaultCode();
                const myUid = getMyUid();
                if (
                  myVault &&
                  ((data.hostVaultCode === myVault && data.hostUid !== myUid) ||
                    (data.blackVaultCode === myVault && data.blackUid !== myUid) ||
                    (data.whiteVaultCode === myVault && data.whiteUid !== myUid) ||
                    (data.studyControllerVaultCode === myVault && data.studyControllerUid !== myUid))
                ) {
                  needsOwnershipHeal = true;
                }
              });

              Object.keys(appState.rooms).forEach((existingId) => {
                if (!seenIds.has(existingId)) {
                  delete appState.rooms[existingId];
                  if (state && state.id === existingId) {
                    handleRemoteRoomDeleted();
                  }
                }
              });

              recoverNicknameFromKnownData(getMyUid());
              if (authUid && authUid !== getMyUid()) {
                recoverNicknameFromKnownData(authUid);
              }
              if (needsOwnershipHeal) {
                reclaimMatchingRolesAcrossRooms(getMyUid(), getMyNickname(), getMyVaultCode());
              }
              renderLobbyRooms();
              tryAutoJoinPendingRoom();
            },
            (err) => {
              updateFirebaseStatusUI('error', `讀取房間列表失敗：${formatFirebaseError(err)}`);
            },
            0,
            200
          );

          if (appState.pendingAutoJoinRoom) {
            fetchAndJoinRemoteRoomByParam(appState.pendingAutoJoinRoom);
          }

          lobbyChatUnsubscribe = cloudSubscribeCollection(
            'lobby_chat',
            (list) => {
              list.sort((a, b) => (a.createdAt || 0) - (b.createdAt || 0));
              appState.lobbyChat = list.slice(-MAX_LOBBY_CHAT);
              recoverNicknameFromKnownData(getMyUid());
              renderLobbyChat();
            },
            () => {},
            0,
            MAX_LOBBY_CHAT
          );
        }

        loadVaultRecordsForCode(getMyVaultCode());
        subscribeVaultProfileStats(getMyVaultCode());
        if (needsCloudRegisterNewCharacter) {
          needsCloudRegisterNewCharacter = false;
          syncVaultProfileToCloud(getMyVaultCode(), getMyUid(), getMyNickname());
        }
      }

