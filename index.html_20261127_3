      function isPrivatePreviewHost(hostname) {
        const h = String(hostname || '').toLowerCase();
        if (!h) return true;
        return (
          h === 'gemini.google.com' ||
          h.endsWith('.gemini.google.com') ||
          h === 'bard.google.com' ||
          h === 'aistudio.google.com' ||
          h.endsWith('.usercontent.goog') ||
          h === 'usercontent.goog' ||
          h.endsWith('.googleusercontent.com') ||
          h === 'googleusercontent.com'
        );
      }

      function getAllAccessibleUrlStrings() {
        const list = [];
        try { if (window.location && window.location.href) list.push(window.location.href); } catch (e) {}
        try { if (window.parent && window.parent !== window && window.parent.location && window.parent.location.href) list.push(window.parent.location.href); } catch (e) {}
        try { if (window.top && window.top !== window && window.top.location && window.top.location.href) list.push(window.top.location.href); } catch (e) {}
        return list.filter(Boolean);
      }

      function normalizeHttpBaseUrl(rawUrl, allowPrivatePreview = false) {
        const trimmed = String(rawUrl || '').trim();
        if (!trimmed) return null;
        try {
          const url = /^https?:\/\//i.test(trimmed) ? new URL(trimmed) : new URL(`https://${trimmed}`);
          if (!['http:', 'https:'].includes(url.protocol)) return null;
          if (!allowPrivatePreview && isPrivatePreviewHost(url.hostname)) return null;
          url.hash = '';
          url.searchParams.delete('room');
          url.searchParams.delete('code');
          url.searchParams.delete('r');
          url.searchParams.delete('uid');
          url.searchParams.delete('nick');
          return url;
        } catch (e) {
          return null;
        }
      }

      function getDetectableBaseUrl() {
        try {
          const ownHref = window.location && window.location.href;
          if (ownHref) {
            const parsedOwn = normalizeHttpBaseUrl(ownHref, false);
            if (parsedOwn) return parsedOwn;
          }
        } catch (e) {}
        const savedBase = safeGetStorage(STORAGE_KEYS.PUBLIC_BASE_URL);
        if (savedBase) {
          const parsedSaved = normalizeHttpBaseUrl(savedBase, false);
          if (parsedSaved) return parsedSaved;
        }
        return null;
      }

      function extractRoomKeyFromInput(rawInput) {
        const trimmed = String(rawInput || '').trim();
        if (!trimmed) return '';
        try {
          if (/^https?:\/\//i.test(trimmed)) {
            const u = new URL(trimmed);
            const fromParam = u.searchParams.get('room') || u.searchParams.get('code') || u.searchParams.get('r');
            if (fromParam) return fromParam.trim();
            if (u.hash) {
              const h = u.hash.replace(/^#/, '');
              if (h.startsWith('room=')) return decodeURIComponent(h.slice(5)).trim();
              if (/^\d{6}$/.test(h)) return h;
              const hp = new URLSearchParams(h);
              const hRoom = hp.get('room') || hp.get('code') || hp.get('r');
              if (hRoom) return hRoom.trim();
            }
          }
        } catch (e) {}
        if (trimmed.startsWith('#')) {
          const h = trimmed.slice(1).trim();
          if (h.startsWith('room=')) return decodeURIComponent(h.slice(5)).trim();
          return h;
        }
        return trimmed;
      }

      function getPendingRoomParamFromUrl() {
        const candidates = getAllAccessibleUrlStrings();
        for (const rawUrl of candidates) {
          try {
            const url = new URL(rawUrl);
            const qRoom = url.searchParams.get('room') || url.searchParams.get('code') || url.searchParams.get('r');
            if (qRoom && qRoom.trim()) return qRoom.trim().replace(/^#/, '');
            if (url.hash) {
              const cleanHash = url.hash.replace(/^#/, '');
              if (cleanHash.startsWith('room=')) {
                return decodeURIComponent(cleanHash.slice(5)).trim();
              }
              if (/^\d{6}$/.test(cleanHash) || cleanHash.startsWith('room_')) {
                return cleanHash;
              }
              const hashParams = new URLSearchParams(cleanHash);
              const hRoom = hashParams.get('room') || hashParams.get('code') || hashParams.get('r');
              if (hRoom && hRoom.trim()) return hRoom.trim();
            }
          } catch (e) {}
        }
        return '';
      }

      function syncBrowserUrlWithRoom(room) {
        try {
          if (!['http:', 'https:', 'file:'].includes(window.location.protocol)) return;
          const url = new URL(window.location.href);
          if (room && (room.code || room.id)) {
            const key = String(room.code || room.id);
            url.searchParams.set('room', key);
            url.hash = `room=${encodeURIComponent(key)}`;
          } else {
            url.searchParams.delete('room');
            url.searchParams.delete('code');
            url.searchParams.delete('r');
            if (url.hash && (url.hash.startsWith('#room=') || /^#\d{6}$/.test(url.hash))) {
              url.hash = '';
            }
          }
          window.history.replaceState(null, '', url.toString());
        } catch (e) {
          try {
            if (room && (room.code || room.id)) {
              window.location.hash = `room=${encodeURIComponent(String(room.code || room.id))}`;
            } else if (window.location.hash.startsWith('#room=')) {
              window.location.hash = '';
            }
          } catch (e2) {}
        }
      }

      function buildRoomShareUrl(room) {
        if (!room) return '';
        const roomKey = String(room.code || room.id);
        const baseUrl = getDetectableBaseUrl();
        if (!baseUrl) return '';
        baseUrl.searchParams.set('room', roomKey);
        baseUrl.hash = `room=${encodeURIComponent(roomKey)}`;
        return baseUrl.toString();
      }

      function copyRoomShareLink() {
