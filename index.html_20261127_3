      function persistIdentityBundle(uid, nickname, isExplicitNick) {
        if (!uid) return;
        const bundle = JSON.stringify({
          uid,
          nickname: isExplicitNick ? nickname : '',
          updatedAt: Date.now()
        });
        safeSetStorage(STORAGE_KEYS.IDENTITY, bundle, true);
      }

      function hydrateIdentityFromBundle() {
        try {
          const raw = safeGetStorage(STORAGE_KEYS.IDENTITY);
          if (!raw) return;
          const parsed = JSON.parse(raw);
          if (parsed && parsed.uid) {
            safeSetStorage(STORAGE_KEYS.UID, parsed.uid, false);
            hasExplicitPersistedUid = true;
          }
          if (parsed && parsed.nickname) {
            safeSetStorage(STORAGE_KEYS.NICKNAME, parsed.nickname, false);
            hasExplicitPersistedNickname = true;
          }
        } catch (e) {}
      }

      function generateId(prefix = 'id') {
        return `${prefix}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`;
      }

      function getMyUid() {
        hydrateIdentityFromBundle();
        let uid = safeGetStorage(STORAGE_KEYS.UID);
        if (uid) {
          if (!uid.startsWith('tmp_')) {
            hasExplicitPersistedUid = true;
          }
          return uid;
        }
        uid = generateId('u');
        isFreshlyGeneratedUid = true;
        if (isBootHydrated) {
          hasExplicitPersistedUid = true;
          safeSetStorage(STORAGE_KEYS.UID, uid, true);
          persistIdentityBundle(uid, '', false);
        } else {
          memoryStorage[STORAGE_KEYS.UID] = uid;
        }
        return uid;
      }

      function getMyNickname() {
        hydrateIdentityFromBundle();
        const stored = safeGetStorage(STORAGE_KEYS.NICKNAME);
        if (stored) {
          hasExplicitPersistedNickname = true;
          return stored;
        }
        if (!fallbackSessionNickname) {
          fallbackSessionNickname = generateNewGuestNickname();
        }
        return fallbackSessionNickname;
      }

      function syncProfileNicknameToCloud(uid, nickname) {
        if (!useFirebase || !uid || !nickname) return;
        const vaultCode = getMyVaultCode();
        const payload = { uid, nickname, vaultCode, updatedAt: Date.now() };
        cloudSetDoc('user_profiles', encodeRtdbKey(uid), payload, { merge: true }).catch(() => {});
        syncVaultProfileToCloud(vaultCode, uid, nickname);
      }

      function setMyNickname(newName, isExplicit = true) {
        const clean = String(newName || '').trim().slice(0, 16);
        if (!clean) return getMyNickname();
        const uid = getMyUid();
        if (isExplicit) {
          hasExplicitPersistedNickname = true;
          safeSetStorage(STORAGE_KEYS.NICKNAME, clean, true);
          persistIdentityBundle(uid, clean, true);
        } else {
          fallbackSessionNickname = clean;
        }
        document.querySelectorAll('.header-nickname-text').forEach((el) => {
          el.textContent = clean;
        });
        if (isExplicit) {
          syncProfileNicknameToCloud(uid, clean);
        }
        return clean;
      }

      function recoverNicknameFromKnownData(uid) {
        if (!uid) return false;
        const prof = appState.cloudProfiles && appState.cloudProfiles[uid];
        if (prof) {
          if (prof.vaultCode && isFreshlyGeneratedVaultCode) {
            isFreshlyGeneratedVaultCode = false;
            safeSetStorage(STORAGE_KEYS.VAULT_CODE, prof.vaultCode, true);
            updateVaultAndCloudStatusUI();
            loadVaultRecordsForCode(prof.vaultCode);
            subscribeVaultProfileStats(prof.vaultCode);
          }
          if (prof.nickname && !hasExplicitPersistedNickname) {
            setMyNickname(prof.nickname, true);
            return true;
          }
        }
        if (hasExplicitPersistedNickname) return false;
        const roomsList = Object.values(appState.rooms || {});
        for (const r of roomsList) {
          if (!r) continue;
          const found =
            (r.blackUid === uid && r.blackName) ||
            (r.whiteUid === uid && r.whiteName) ||
            (r.studyControllerUid === uid && r.studyControllerName) ||
            (r.hostUid === uid && r.hostName) ||
            '';
          if (found) {
            setMyNickname(found, true);
            renderLobbyRooms();
            if (state) updateAllRoomUI();
            return true;
          }
        }
        const chats = appState.lobbyChat || [];
        for (let i = chats.length - 1; i >= 0; i--) {
          if (chats[i] && chats[i].uid === uid && chats[i].name) {
            setMyNickname(chats[i].name, true);
            return true;
          }
        }
        return false;
      }

      function adoptPersistedIdentity(targetUid, targetNickname, isExplicitNick = false) {
        const oldUid = getMyUid();
        const oldName = getMyNickname();
        const myVault = getMyVaultCode();
        let changed = false;

        if (targetUid && targetUid !== oldUid) {
          safeSetStorage(STORAGE_KEYS.UID, targetUid, true);
          hasExplicitPersistedUid = true;
          isFreshlyGeneratedUid = false;
          changed = true;
        }
        if (targetNickname && (isExplicitNick || !hasExplicitPersistedNickname)) {
          setMyNickname(targetNickname, isExplicitNick);
          changed = true;
        } else if (changed) {
          persistIdentityBundle(getMyUid(), hasExplicitPersistedNickname ? getMyNickname() : '', hasExplicitPersistedNickname);
        }

        const finalUid = getMyUid();
        const finalName = getMyNickname();

        if (changed && (oldUid !== finalUid || (hasExplicitPersistedNickname && oldName !== finalName))) {
          Object.values(appState.rooms || {}).forEach((r) => {
            if (!r) return;
            let cloudRoomChanged = false;
            if (r.hostUid === oldUid || r.hostUid === finalUid || (myVault && r.hostVaultCode === myVault)) {
              r.hostUid = finalUid;
              if (myVault) r.hostVaultCode = myVault;
              if (hasExplicitPersistedNickname) r.hostName = finalName;
              cloudRoomChanged = true;
            }
            if (r.blackUid === oldUid || r.blackUid === finalUid || (myVault && r.blackVaultCode === myVault)) {
              r.blackUid = finalUid;
              if (myVault) r.blackVaultCode = myVault;
              if (hasExplicitPersistedNickname) r.blackName = finalName;
              cloudRoomChanged = true;
            }
            if (r.whiteUid === oldUid || r.whiteUid === finalUid || (myVault && r.whiteVaultCode === myVault)) {
              r.whiteUid = finalUid;
              if (myVault) r.whiteVaultCode = myVault;
              if (hasExplicitPersistedNickname) r.whiteName = finalName;
              cloudRoomChanged = true;
            }
            if (r.studyControllerUid === oldUid || r.studyControllerUid === finalUid || (myVault && r.studyControllerVaultCode === myVault)) {
              r.studyControllerUid = finalUid;
              if (myVault) r.studyControllerVaultCode = myVault;
              if (hasExplicitPersistedNickname) r.studyControllerName = finalName;
              cloudRoomChanged = true;
            }
            if (cloudRoomChanged && useFirebase) {
              cloudSetDoc('rooms', r.id, serializeRoomForFirestore(r), { merge: true }).catch(() => {});
            }
          });

          if (state) {
            let roomTouched = false;
            if (state.hostUid === oldUid || state.hostUid === finalUid || (myVault && state.hostVaultCode === myVault)) {
              state.hostUid = finalUid;
              if (myVault) state.hostVaultCode = myVault;
              if (hasExplicitPersistedNickname) state.hostName = finalName;
              roomTouched = true;
            }
            if (state.blackUid === oldUid || state.blackUid === finalUid || (myVault && state.blackVaultCode === myVault)) {
              state.blackUid = finalUid;
              if (myVault) state.blackVaultCode = myVault;
              if (hasExplicitPersistedNickname) state.blackName = finalName;
              roomTouched = true;
            }
            if (state.whiteUid === oldUid || state.whiteUid === finalUid || (myVault && state.whiteVaultCode === myVault)) {
              state.whiteUid = finalUid;
              if (myVault) state.whiteVaultCode = myVault;
              if (hasExplicitPersistedNickname) state.whiteName = finalName;
              roomTouched = true;
            }
            if (state.studyControllerUid === oldUid || state.studyControllerUid === finalUid || (myVault && state.studyControllerVaultCode === myVault)) {
              state.studyControllerUid = finalUid;
              if (myVault) state.studyControllerVaultCode = myVault;
              if (hasExplicitPersistedNickname) state.studyControllerName = finalName;
              roomTouched = true;
            }
            if (roomTouched) {
              updateMyRoomPresence(state.id, true);
              persistCurrentRoomAndSync(false);
            }
          }
        }

        if (changed) {
          renderLobbyRooms();
          if (state) updateAllRoomUI();
        }
      }

      function getCoordLabel(x, y, size) {
        if (x < 0 || y < 0 || x >= size || y >= size) return '虛手';
        const col = COLS_STR[x] || '?';
        const row = size - y;
        return `${col}${row}`;
      }

      function formatSeconds(sec) {
        if (sec == null || sec < 0) return '無限';
        const s = Math.max(0, Math.floor(sec));
        if (s >= 86400) {
          const d = Math.floor(s / 86400);
          const h = Math.floor((s % 86400) / 3600);
          const m = Math.floor((s % 3600) / 60);
          return `${d}天${String(h).padStart(2, '0')}時${String(m).padStart(2, '0')}分`;
        }
        if (s >= 3600) {
          const h = Math.floor(s / 3600);
          const m = Math.floor((s % 3600) / 60);
          const r = s % 60;
          return `${h}:${String(m).padStart(2, '0')}:${String(r).padStart(2, '0')}`;
        }
        const m = Math.floor(s / 60);
        const r = s % 60;
        return `${String(m).padStart(2, '0')}:${String(r).padStart(2, '0')}`;
      }

      function formatByoyomiShortLabel(sec) {
        if (sec === 604800) return '1週';
        if (sec === 86400) return '1天';
        if (sec === 3600) return '1小時';
        if (sec === 1800) return '30分';
        return `${sec}s`;
      }

      function formatWaitTimeoutOptionLabel(sec) {
        const s = Number(sec) || 0;
        if (s === 600) return '十分鐘';
        if (s === 1800) return '三十分鐘';
        if (s === 3600) return '一小時';
        if (s === 86400) return '一天';
        if (s > 0) return `${Math.round(s / 60)}分鐘`;
        return '無限等待';
      }

      function formatRemainingWaitTime(ms) {
        const totalSec = Math.max(0, Math.ceil((Number(ms) || 0) / 1000));
        if (totalSec >= 86400) {
          const d = Math.floor(totalSec / 86400);
          const h = Math.floor((totalSec % 86400) / 3600);
          return `${d}天${h}時`;
        }
        if (totalSec >= 3600) {
          const h = Math.floor(totalSec / 3600);
          const m = Math.floor((totalSec % 3600) / 60);
          return `${h}時${String(m).padStart(2, '0')}分`;
        }
        if (totalSec >= 60) {
          const m = Math.floor(totalSec / 60);
          const s = totalSec % 60;
          return `${m}分${String(s).padStart(2, '0')}秒`;
        }
