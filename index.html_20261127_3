      function applyIncomingRoomSnapshot(rawIncoming) {
        const incoming = normalizeRoomFromRemote(rawIncoming);
        if (!incoming || !state || incoming.id !== state.id) return;
        if (incoming.deleted || appState.deletedRoomIds.has(incoming.id)) {
          delete appState.rooms[incoming.id];
          handleRemoteRoomDeleted();
          return;
        }
        if (isRoomWaitExpired(incoming, Date.now())) {
          expireAndRemoveWaitingRoom(incoming);
          return;
        }
        if ((incoming.updatedAt || 0) < localVersionTs) return;
        localVersionTs = incoming.updatedAt || Date.now();
        const prevMovesLen = (state.moves || []).length;
        state = incoming;
        let shouldPlayIncomingStone = true;

        if (state.mode === 'study') {
          ensureStudyBranchesInitialized(false);
          if (isStudyPresenter()) {
            appState.spectatorLocalStudy = null;
          } else if (appState.spectatorLocalStudy) {
            syncPresenterBranchesIntoSpectatorLocal();
          }
          shouldPlayIncomingStone = !appState.spectatorLocalStudy;
        } else if (state.mode === 'match') {
          if (state.status === 'finished' && state.result && !state.statsRecorded) {
            settleFinishedMatchVaultStats();
          }
          const role = getMyRole();
          if (appState.spectatorLocalMatch) {
            shouldPlayIncomingStone = syncLiveMovesIntoMatchSpectatorLocal(prevMovesLen);
            const newMovesLenAfterSync = (state.moves || []).length;
            if (
              role !== 'S' &&
              newMovesLenAfterSync > prevMovesLen &&
              state.status === 'playing' &&
              state.turn === role
            ) {
              showToast('🔔 對手已落子，輪到您落子！（可隨時點「回到對局實況」）', 3200);
            }
          } else {
            shouldPlayIncomingStone = true;
          }
        }
        const newMovesLen = (state.moves || []).length;
        if (newMovesLen > prevMovesLen && shouldPlayIncomingStone) {
          playStoneSound();
        }
        updateAllRoomUI();
      }

