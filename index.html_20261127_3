      // ==================== 2. 三層清脆落子與讀秒音效引擎 ====================
      let audioCtx = null;
      let noiseBuffer = null;

      function ensureAudioContext() {
        if (!audioCtx) {
          const Ctx = window.AudioContext || window.webkitAudioContext;
          if (Ctx) audioCtx = new Ctx();
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume().catch(() => {});
        }
        if (audioCtx && !noiseBuffer) {
          const sampleRate = audioCtx.sampleRate;
          const length = Math.floor(sampleRate * 0.025);
          noiseBuffer = audioCtx.createBuffer(1, length, sampleRate);
          const data = noiseBuffer.getChannelData(0);
          for (let i = 0; i < length; i++) {
            data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (sampleRate * 0.004));
          }
        }
      }

      function playStoneSound() {
        try {
          ensureAudioContext();
          if (!audioCtx) return;
          const now = audioCtx.currentTime;
          const pitchJitter = 0.96 + Math.random() * 0.08;

          if (noiseBuffer) {
            const noise = audioCtx.createBufferSource();
            noise.buffer = noiseBuffer;
            const filter = audioCtx.createBiquadFilter();
            filter.type = 'bandpass';
            filter.frequency.setValueAtTime(2650 * pitchJitter, now);
            filter.Q.setValueAtTime(2.4, now);
            const nGain = audioCtx.createGain();
            nGain.gain.setValueAtTime(0.45, now);
            nGain.gain.exponentialRampToValueAtTime(0.001, now + 0.022);
            noise.connect(filter);
            filter.connect(nGain);
            nGain.connect(audioCtx.destination);
            noise.start(now);
          }

          const clackOsc = audioCtx.createOscillator();
          const clackGain = audioCtx.createGain();
          clackOsc.type = 'triangle';
          clackOsc.frequency.setValueAtTime(1620 * pitchJitter, now);
          clackOsc.frequency.exponentialRampToValueAtTime(780 * pitchJitter, now + 0.032);
          clackGain.gain.setValueAtTime(0.32, now);
          clackGain.gain.exponentialRampToValueAtTime(0.001, now + 0.034);
          clackOsc.connect(clackGain);
          clackGain.connect(audioCtx.destination);
          clackOsc.start(now);
          clackOsc.stop(now + 0.036);

          const bodyOsc = audioCtx.createOscillator();
          const bodyGain = audioCtx.createGain();
          bodyOsc.type = 'sine';
          bodyOsc.frequency.setValueAtTime(365 * pitchJitter, now);
          bodyOsc.frequency.exponentialRampToValueAtTime(155 * pitchJitter, now + 0.055);
          bodyGain.gain.setValueAtTime(0.26, now);
          bodyGain.gain.exponentialRampToValueAtTime(0.001, now + 0.058);
          bodyOsc.connect(bodyGain);
          bodyGain.connect(audioCtx.destination);
          bodyOsc.start(now);
          bodyOsc.stop(now + 0.06);
        } catch (e) {}
      }

      function playClockTickSound(isFinal = false) {
        if (!appState.clockTickSound) return;
        try {
          ensureAudioContext();
          if (!audioCtx) return;
          const now = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(isFinal ? 1180 : 880, now);
          osc.frequency.exponentialRampToValueAtTime(isFinal ? 740 : 560, now + 0.055);
          gain.gain.setValueAtTime(isFinal ? 0.24 : 0.16, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.065);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.07);
        } catch (e) {}
      }

      // ==================== 3. 圍棋規則引擎（提子、打劫、中國數子點目） ====================
      function createEmptyBoard(size) {
        return Array.from({ length: size }, () => Array(size).fill(0));
      }

      function cloneBoard(board) {
        return board.map((row) => row.slice());
      }

      function boardToHash(board) {
        return board.map((r) => r.join('')).join('|');
      }

      function getNeighbors(x, y, size) {
        const list = [];
        if (x > 0) list.push([x - 1, y]);
        if (x < size - 1) list.push([x + 1, y]);
        if (y > 0) list.push([x, y - 1]);
        if (y < size - 1) list.push([x, y + 1]);
        return list;
      }

      function getGroupAndLiberties(board, startX, startY) {
        const size = board.length;
        const color = board[startY][startX];
        if (!color) return { stones: [], liberties: 0 };
        const visited = new Set();
        const libSet = new Set();
        const stones = [];
        const stack = [[startX, startY]];
        visited.add(`${startX},${startY}`);

        while (stack.length) {
          const [cx, cy] = stack.pop();
          stones.push([cx, cy]);
          for (const [nx, ny] of getNeighbors(cx, cy, size)) {
            const val = board[ny][nx];
            if (val === 0) {
              libSet.add(`${nx},${ny}`);
            } else if (val === color) {
              const key = `${nx},${ny}`;
              if (!visited.has(key)) {
                visited.add(key);
                stack.push([nx, ny]);
              }
            }
          }
        }
        return { stones, liberties: libSet.size };
      }

      function tryApplyMoveOnBoard(board, x, y, color, previousBoardHash = '') {
        const size = board.length;
        if (x < 0 || y < 0 || x >= size || y >= size) {
          return { ok: false, reason: '超出棋盤範圍' };
        }
        if (board[y][x] !== 0) {
          return { ok: false, reason: '此交叉點已有棋子' };
        }

        const next = cloneBoard(board);
        next[y][x] = color;
        const opponent = color === 1 ? 2 : 1;
        let capturedCount = 0;

        for (const [nx, ny] of getNeighbors(x, y, size)) {
          if (next[ny][nx] === opponent) {
            const grp = getGroupAndLiberties(next, nx, ny);
            if (grp.liberties === 0) {
              for (const [sx, sy] of grp.stones) {
                next[sy][sx] = 0;
                capturedCount++;
              }
            }
          }
        }

        const myGrp = getGroupAndLiberties(next, x, y);
        if (myGrp.liberties === 0) {
          return { ok: false, reason: '禁著點（不可自殺）' };
        }

        const nextHash = boardToHash(next);
        if (previousBoardHash && nextHash === previousBoardHash) {
          return { ok: false, reason: '打劫禁著，請先尋劫' };
        }

        return { ok: true, board: next, captured: capturedCount, hash: nextHash };
      }

      function computeChineseScore(board, komi = 7.5) {
        const size = board.length;
        let blackArea = 0;
        let whiteArea = 0;
        const visited = Array.from({ length: size }, () => Array(size).fill(false));

        for (let y = 0; y < size; y++) {
          for (let x = 0; x < size; x++) {
            const v = board[y][x];
            if (v === 1) {
              blackArea++;
            } else if (v === 2) {
              whiteArea++;
            } else if (!visited[y][x]) {
              const region = [];
              const borders = new Set();
              const stack = [[x, y]];
              visited[y][x] = true;
              while (stack.length) {
                const [cx, cy] = stack.pop();
                region.push([cx, cy]);
                for (const [nx, ny] of getNeighbors(cx, cy, size)) {
                  const nv = board[ny][nx];
                  if (nv === 0 && !visited[ny][nx]) {
                    visited[ny][nx] = true;
                    stack.push([nx, ny]);
                  } else if (nv === 1 || nv === 2) {
                    borders.add(nv);
                  }
                }
              }
              if (borders.size === 1) {
                if (borders.has(1)) blackArea += region.length;
                else if (borders.has(2)) whiteArea += region.length;
              }
            }
          }
        }

        const whiteTotal = whiteArea + komi;
        const diff = blackArea - whiteTotal;
        return {
          blackArea,
          whiteArea,
          komi,
          whiteTotal,
          winner: diff > 0 ? 'B' : 'W',
          margin: Math.abs(diff)
        };
      }

