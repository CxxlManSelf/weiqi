        const size = Number(appState.createDraft.size) || 19;
        const seat = appState.createDraft.seat || 'B';

        document.querySelectorAll('.create-mode-btn').forEach((b) => {
          const active = b.dataset.createMode === mode;
          b.className = active
            ? 'create-mode-btn py-2 px-3 rounded-xl border-2 border-amber-500 bg-amber-50 text-amber-950 font-bold'
            : 'create-mode-btn py-2 px-3 rounded-xl border-2 border-stone-200 bg-white text-stone-700 font-bold';
        });
        document.querySelectorAll('.create-size-btn').forEach((b) => {
          const active = Number(b.dataset.createSize) === size;
          b.className = active
            ? 'create-size-btn py-2 rounded-xl border-2 border-stone-900 bg-stone-900 text-white font-bold'
            : 'create-size-btn py-2 rounded-xl border-2 border-stone-200 bg-white text-stone-700 font-bold';
        });
        document.querySelectorAll('.create-seat-btn').forEach((b) => {
          const active = b.dataset.createSeat === seat;
          b.className = active
            ? 'create-seat-btn py-1.5 rounded-xl border-2 border-stone-900 bg-stone-900 text-white font-bold text-xs'
            : 'create-seat-btn py-1.5 rounded-xl border-2 border-stone-200 bg-white text-stone-700 font-bold text-xs';
        });
        document.getElementById('create-match-options')?.classList.toggle('hidden', mode === 'study');

        const titleInput = document.getElementById('create-room-title-input');
        if (titleInput) {
          const suffix = mode === 'study' ? '的擺盤研究室' : '的對弈室';
          titleInput.value = `${getMyNickname()}${suffix}`;
        }
        document.getElementById('create-room-modal')?.classList.remove('hidden');
      }

      let isCreatingRoom = false;
      async function confirmCreateRoom(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        if (isCreatingRoom) return;
        isCreatingRoom = true;
        const createBtn = document.getElementById('confirm-create-room-btn');
        const originalBtnText = createBtn ? createBtn.textContent : '立即建立';
        if (createBtn) {
          createBtn.disabled = true;
          createBtn.textContent = '⏳ 建立至 Firebase 中...';
        }

        try {
          if (!useFirebase) {
            const connected = await ensureFirebaseConnected();
            if (!connected) {
              throw new Error('Firebase 雲端資料庫尚未連線，請確認網路狀態後重試');
            }
          }
          const mode = appState.createDraft.mode || 'match';
          const isStudy = mode === 'study';
          const boardSize = Number(appState.createDraft.size) || 19;
          const rawTitle = document.getElementById('create-room-title-input')?.value.trim();
          const title = rawTitle || `${getMyNickname()}${isStudy ? '的擺盤研究室' : '的對弈室'}`;
          const mainTime = isStudy ? 0 : (Number(document.getElementById('create-maintime-select')?.value || 0) || 0);
          const byoVal = isStudy ? 'none' : (document.getElementById('create-byoyomi-select')?.value || 'none');
          const { seconds: byoyomiSeconds, periods: byoyomiPeriods } = parseByoyomiOption(byoVal);
          const waitTimeoutSeconds = isStudy ? 0 : (Number(document.getElementById('create-wait-timeout-select')?.value || 0) || 0);
          const seat = appState.createDraft.seat || 'B';

          const myUid = getMyUid();
          const myVault = getMyVaultCode();
          const myName = getMyNickname();
          const now = Date.now();
          const roomId = generateId('room');
          const code = String(Math.floor(100000 + Math.random() * 900000));
          const waitDeadlineAt = !isStudy && waitTimeoutSeconds > 0 ? now + waitTimeoutSeconds * 1000 : 0;

          const initialBoard = createEmptyBoard(boardSize);
          const initialBranchId = 'branch_main';

          const newRoom = {
            id: roomId,
            code,
            title,
            mode,
            boardSize,
            hostUid: myUid,
            hostVaultCode: myVault,
            hostName: myName,
            createdAt: now,
            updatedAt: now,
            lastActivityAt: now,
            activeMembers: { [myUid]: { uid: myUid, vaultCode: myVault, name: myName, joinedAt: now, lastSeenAt: now } },
            status: isStudy ? 'playing' : 'waiting',
            waitTimeoutSeconds,
            waitDeadlineAt,
            blackUid: mode === 'match' && seat === 'B' ? myUid : null,
            blackVaultCode: mode === 'match' && seat === 'B' ? myVault : null,
            blackName: mode === 'match' && seat === 'B' ? myName : '',
            whiteUid: mode === 'match' && seat === 'W' ? myUid : null,
            whiteVaultCode: mode === 'match' && seat === 'W' ? myVault : null,
            whiteName: mode === 'match' && seat === 'W' ? myName : '',
            turn: 'B',
            board: initialBoard,
            moves: [],
            captures: { B: 0, W: 0 },
            previousBoardHash: '',
            consecutivePasses: 0,
            mainTime,
            byoyomiSeconds,
            byoyomiPeriods,
            clocks: {
              B: { main: mainTime, byoLeft: byoyomiSeconds, periodsLeft: byoyomiPeriods, inByo: mainTime === 0 && byoyomiSeconds > 0 },
              W: { main: mainTime, byoLeft: byoyomiSeconds, periodsLeft: byoyomiPeriods, inByo: mainTime === 0 && byoyomiSeconds > 0 }
            },
            lastTickAt: now,
            pendingRequest: null,
            result: null,
            statsRecorded: false,
            studyControllerUid: isStudy ? myUid : null,
            studyControllerVaultCode: isStudy ? myVault : null,
            studyControllerName: isStudy ? myName : '',
            activeBranchId: initialBranchId,
            studyBranches: {
              [initialBranchId]: {
                id: initialBranchId,
                name: '主線',
                moves: [],
                cursor: 0,
                rezeroOffset: 0,
                setupStones: []
              }
            }
          };

          const cloudDoc = serializeRoomForFirestore(newRoom);
          await cloudSetDoc('rooms', roomId, cloudDoc);

          appState.rooms[roomId] = serializeRoomForStorage(newRoom);
          state = newRoom;
          localVersionTs = now;
          appState.pendingMove = null;
          isFreshlyGeneratedVaultCode = false;
          safeSetStorage(STORAGE_KEYS.VAULT_CODE, myVault, true);
          syncVaultProfileToCloud(myVault, myUid, myName);
          closeAllModals();
          enterRoom(roomId);
          showToast(isStudy ? '✅ 已在 Firebase 成功建立擺盤研究室！' : '✅ 已在 Firebase 成功建立對弈室！');
        } catch (err) {
          console.error('建立房間失敗:', err);
          showToast(`❌ 建立房間失敗：${formatFirebaseError(err)}`, 4500);
        } finally {
          isCreatingRoom = false;
          if (createBtn) {
            createBtn.disabled = false;
            createBtn.textContent = originalBtnText;
          }
        }
      }

      function enterRoom(roomId) {
        const room = appState.rooms[roomId];
        if (!room) {
          showToast('找不到該房間或房間已被刪除');
          return;
        }
        if (isRoomWaitExpired(room, Date.now())) {
          expireAndRemoveWaitingRoom(room);
          showToast('此對弈室已超過等待入席時限並自動刪除');
          return;
        }
        state = normalizeRoomFromRemote(serializeRoomForStorage(room));
        localVersionTs = state.updatedAt || Date.now();
        appState.pendingMove = null;
        appState.pendingAutoJoinRoom = '';
        appState.mobileRoomTab = 'control';
        appState.lastNotifiedPassCount = state.consecutivePasses || 0;
        appState.lastFinishedBannerId = '';
        appState.spectatorLocalStudy = null;
        appState.spectatorLocalMatch = null;
        appState.roomMembers = {};
        myRoomJoinedAt = Date.now();
        syncBrowserUrlWithRoom(state);

        if (state.mode === 'study') {
          ensureStudyBranchesInitialized(false);
          if (state.studyControllerUid === getMyUid() && state.studyControllerName !== getMyNickname()) {
            state.studyControllerName = getMyNickname();
            persistCurrentRoomAndSync(false);
          }
        }

        const myUid = getMyUid();
        const myVault = getMyVaultCode();
        const myName = getMyNickname();
        let ownerSynced = false;

        if (isRoomHost(state)) {
          if (state.hostUid !== myUid || state.hostVaultCode !== myVault || state.hostName !== myName) {
            state.hostUid = myUid;
            state.hostVaultCode = myVault;
            state.hostName = myName;
            ownerSynced = true;
          }
        }

        if (state.mode === 'study') {
          ensureStudyBranchesInitialized(false);
          if (isStudyPresenter()) {
            if (state.studyControllerUid !== myUid || state.studyControllerVaultCode !== myVault || state.studyControllerName !== myName) {
              state.studyControllerUid = myUid;
              state.studyControllerVaultCode = myVault;
              state.studyControllerName = myName;
              ownerSynced = true;
            }
          }
        } else if (state.mode === 'match') {
          const role = getMyRole();
          if (role === 'B' && (state.blackUid !== myUid || state.blackVaultCode !== myVault || state.blackName !== myName)) {
            state.blackUid = myUid;
            state.blackVaultCode = myVault;
            state.blackName = myName;
            ownerSynced = true;
          }
          if (role === 'W' && (state.whiteUid !== myUid || state.whiteVaultCode !== myVault || state.whiteName !== myName)) {
            state.whiteUid = myUid;
            state.whiteVaultCode = myVault;
            state.whiteName = myName;
            ownerSynced = true;
          }
        }
        if (ownerSynced) persistCurrentRoomAndSync(false);

        document.getElementById('lobby-view')?.classList.add('hidden');
        document.getElementById('header-lobby-bar')?.classList.add('hidden');
        document.getElementById('room-view')?.classList.remove('hidden');
        document.getElementById('header-room-bar')?.classList.remove('hidden');

        subscribeToRoomRealtime(roomId);
        startRoomPresenceHeartbeat(roomId);
        updateAllRoomUI();
        setTimeout(resizeAndDrawBoard, 30);
      }

      function leaveRoom() {
        const wasPresenter = state && state.mode === 'study' && isStudyPresenter();
        const leavingRoomId = state ? state.id : null;
        stopRoomPresenceHeartbeat(leavingRoomId);
        appState.spectatorLocalStudy = null;
        appState.spectatorLocalMatch = null;
        appState.roomMembers = {};

        if (studyCursorSyncTimer) {
          clearTimeout(studyCursorSyncTimer);
          studyCursorSyncTimer = null;
        }
        if (roomUnsubscribe) {
          roomUnsubscribe();
          roomUnsubscribe = null;
        }
        if (roomChatUnsubscribe) {
          roomChatUnsubscribe();
          roomChatUnsubscribe = null;
        }
        renderedRoomChatIds.clear();
        state = null;
        appState.pendingMove = null;
        appState.pendingAutoJoinRoom = '';
        syncBrowserUrlWithRoom(null);

        document.getElementById('room-view')?.classList.add('hidden');
        document.getElementById('header-room-bar')?.classList.add('hidden');
        document.getElementById('lobby-view')?.classList.remove('hidden');
        document.getElementById('header-lobby-bar')?.classList.remove('hidden');
        renderLobbyRooms();

        if (wasPresenter) {
          showToast('已返回大廳（系統已為您保留擺盤主講權）');
        }
      }

      function handleDeleteCurrentRoom() {
        if (!state) return;
        if (!isRoomHost(state)) {
          showToast('僅房主可刪除房間');
          return;
        }
        openCustomConfirm(
          '確定要從 Firebase 雲端永久刪除此房間嗎？所有在場棋友將返回大廳。',
          () => deleteRoomById(state.id),
          '刪除雲端房間'
        );
      }

      async function deleteRoomById(roomId) {
        const target = appState.rooms[roomId] || (state && state.id === roomId ? state : null);
        if (!target || !isRoomHost(target)) {
          showToast('僅房主可刪除此房間');
          return;
        }
        if (!useFirebase) {
          showToast('❌ Firebase 尚未連線，無法刪除雲端房間');
          return;
        }

        try {
          await cloudDeleteDoc('rooms', roomId);
          cloudDeleteDoc('room_messages', roomId).catch(() => {});

          appState.deletedRoomIds.add(roomId);
          delete appState.rooms[roomId];

          if (state && state.id === roomId) {
            showToast('✅ 已從 Firebase 刪除房間');
            leaveRoom();
          } else {
            renderLobbyRooms();
            showToast('✅ 已從 Firebase 刪除房間');
          }
        } catch (err) {
          console.error('刪除房間失敗:', err);
          showToast(`❌ 刪除房間失敗：${formatFirebaseError(err)}`, 4500);
        }
      }

      function expireAndRemoveWaitingRoom(room) {
        if (!room || !room.id || appState.deletedRoomIds.has(room.id)) return;
        const roomId = room.id;
        appState.deletedRoomIds.add(roomId);
        delete appState.rooms[roomId];

        if (useFirebase && rtdb) {
          cloudDeleteDoc('rooms', roomId).catch(() => {});
          cloudDeleteDoc('room_messages', roomId).catch(() => {});
        }

        if (state && state.id === roomId) {
          showToast('⏳ 等待入席已逾時，系統已自動關閉並刪除房間', 3800);
          leaveRoom();
        } else {
          renderLobbyRooms();
        }
      }

      function sweepExpiredWaitingRooms() {
        const now = Date.now();
        Object.values(appState.rooms || {}).forEach((r) => {
          if (isRoomWaitExpired(r, now)) {
            expireAndRemoveWaitingRoom(r);
          }
        });
        if (state && isRoomWaitExpired(state, now)) {
          expireAndRemoveWaitingRoom(state);
        }
      }

      function updateWaitCountdownsUI() {
        const now = Date.now();
        document.querySelectorAll('[data-wait-deadline]').forEach((el) => {
          const deadline = Number(el.dataset.waitDeadline) || 0;
          if (!deadline) return;
          const rem = deadline - now;
          if (rem <= 0) {
            el.textContent = '⏳ 逾時清理中...';
          } else {
            el.textContent = `⏳ 剩 ${formatRemainingWaitTime(rem)}`;
          }
        });

        if (state && state.mode === 'match' && state.status === 'waiting') {
          const lbl = document.getElementById('match-open-seats-label');
          if (lbl) {
            const deadline = Number(state.waitDeadlineAt) || 0;
            if (deadline > now) {
              lbl.textContent = `🪑 席位開放中（先搶先贏 · 剩 ${formatRemainingWaitTime(deadline - now)} 自動刪房）：`;
            } else {
              lbl.textContent = '🪑 席位開放中（先搶先贏）：';
            }
          }
        }
      }

      function handleRemoteRoomDeleted() {
        if (!state) return;
        showToast('房間已關閉或被刪除');
        leaveRoom();
      }

      function subscribeToRoomRealtime(roomId) {
        if (roomUnsubscribe) roomUnsubscribe();
        if (roomChatUnsubscribe) roomChatUnsubscribe();
        renderedRoomChatIds.clear();
        const chatBox = document.getElementById('room-chat-messages');
        if (chatBox) chatBox.innerHTML = '';

        if (useFirebase && rtdb) {
          let hasSeenRemoteDoc = false;
          roomUnsubscribe = cloudSubscribeDoc(
            'rooms',
            roomId,
            (docData) => {
              if (!docData) {
                if (hasSeenRemoteDoc) {
                  handleRemoteRoomDeleted();
                }
                return;
              }
              hasSeenRemoteDoc = true;
              applyIncomingRoomSnapshot(docData);
            },
            (err) => {
              showToast(`⚠️ 房間同步異常：${formatFirebaseError(err)}`);
            }
          );

          roomChatUnsubscribe = cloudSubscribeCollection(
            `room_messages/${roomId}`,
            (msgs) => {
              msgs.sort((a, b) => (a.createdAt || 0) - (b.createdAt || 0));
              msgs.slice(-150).forEach((m) => appendRoomChatMessage(m, true));
            },
            () => {},
            0,
            150
          );
        } else {
          renderRoomMembersList();
        }
      }

      // ==================== 6.5 房內在線成員列表（RTDB onDisconnect 原生離線自動清除） ====================
      function startRoomPresenceHeartbeat(roomId) {
        updateMyRoomPresence(roomId, true);
      }

      function stopRoomPresenceHeartbeat(roomId) {
        if (currentPresenceRef) {
          try { currentPresenceRef.onDisconnect().cancel(); } catch (e) {}
          try { currentPresenceRef.remove(); } catch (e) {}
          currentPresenceRef = null;
        }
        if (!roomId) return;
        const myUid = getMyUid();

        const targetRoom = appState.rooms[roomId];
        if (targetRoom && targetRoom.activeMembers && targetRoom.activeMembers[myUid]) {
          delete targetRoom.activeMembers[myUid];
        }

        if (useFirebase && rtdb && !appState.deletedRoomIds.has(roomId)) {
          getCloudRef(`rooms/${roomId}/activeMembers/${myUid}`).remove().catch(() => {});
        }
      }

      function updateMyRoomPresence(roomId, syncCloud = true) {
        if (!roomId) return;
        const myUid = getMyUid();
        const myVault = getMyVaultCode();
        const now = Date.now();
        const entry = {
          uid: myUid,
          vaultCode: myVault,
          name: getMyNickname(),
          joinedAt: myRoomJoinedAt || now,
          lastSeenAt: now
        };
        appState.roomMembers[myUid] = entry;

        if (state && state.id === roomId) {
          if (!state.activeMembers || typeof state.activeMembers !== 'object') {
            state.activeMembers = {};
          }
          state.activeMembers[myUid] = entry;
        }
        if (appState.rooms[roomId]) {
          if (!appState.rooms[roomId].activeMembers || typeof appState.rooms[roomId].activeMembers !== 'object') {
            appState.rooms[roomId].activeMembers = {};
          }
          appState.rooms[roomId].activeMembers[myUid] = entry;
        }

        if (syncCloud && useFirebase && rtdb && !appState.deletedRoomIds.has(roomId)) {
          const memberRef = getCloudRef(`rooms/${roomId}/activeMembers/${myUid}`);
          currentPresenceRef = memberRef;
          memberRef.onDisconnect().remove().catch(() => {});
          memberRef.set(sanitizeForRtdb(entry)).catch(() => {});
        }
      }

      function renderRoomMembersList() {
        const listEl = document.getElementById('room-members-list');
        const countEl = document.getElementById('room-members-count');
        if (!listEl || !state) return;

        const now = Date.now();
        const myUid = getMyUid();
        const merged = {};

        Object.entries(state.activeMembers || {}).forEach(([uid, rawInfo]) => {
          if (!uid || !rawInfo) return;
          if (typeof rawInfo === 'number') {
            if (now - rawInfo <= MEMBER_STALE_MS) {
              merged[uid] = { uid, name: '棋友', vaultCode: '', joinedAt: rawInfo, lastSeenAt: rawInfo };
            }
          } else if (typeof rawInfo === 'object') {
            const ts = rawInfo.lastSeenAt || now;
            if (now - ts <= MEMBER_STALE_MS) {
              merged[uid] = { ...rawInfo, uid };
            }
          }
        });

        merged[myUid] = {
          uid: myUid,
          vaultCode: getMyVaultCode(),
          name: getMyNickname(),
          joinedAt: (merged[myUid] && merged[myUid].joinedAt) || myRoomJoinedAt || now,
          lastSeenAt: now
        };

        if (state.mode === 'match') {
          const blackMember = state.blackUid ? merged[state.blackUid] : null;
          if (blackMember) {
            if (state.blackName) blackMember.name = state.blackName;
            if (state.blackVaultCode) blackMember.vaultCode = state.blackVaultCode;
          }
          const whiteMember = state.whiteUid ? merged[state.whiteUid] : null;
          if (whiteMember) {
            if (state.whiteName) whiteMember.name = state.whiteName;
            if (state.whiteVaultCode) whiteMember.vaultCode = state.whiteVaultCode;
          }
        } else if (state.mode === 'study') {
          const presenterMember = state.studyControllerUid ? merged[state.studyControllerUid] : null;
          if (presenterMember) {
            if (state.studyControllerName) presenterMember.name = state.studyControllerName;
            if (state.studyControllerVaultCode) presenterMember.vaultCode = state.studyControllerVaultCode;
          }
        }
        const hostMember = state.hostUid ? merged[state.hostUid] : null;
        if (hostMember && state.hostVaultCode && !hostMember.vaultCode) {
          hostMember.vaultCode = state.hostVaultCode;
        }

        const getRolePriority = (m) => {
          if (state.mode === 'match') {
            if (state.blackUid === m.uid || (state.blackVaultCode && m.vaultCode === state.blackVaultCode)) return 1;
            if (state.whiteUid === m.uid || (state.whiteVaultCode && m.vaultCode === state.whiteVaultCode)) return 2;
          } else if (state.mode === 'study') {
            if (state.studyControllerUid === m.uid || (state.studyControllerVaultCode && m.vaultCode === state.studyControllerVaultCode)) return 1;
          }
          if (state.hostUid === m.uid || (state.hostVaultCode && m.vaultCode === state.hostVaultCode)) return 3;
          if (m.uid === myUid) return 4;
          return 5;
        };

        const members = Object.values(merged).sort((a, b) => {
          const pa = getRolePriority(a);
          const pb = getRolePriority(b);
          if (pa !== pb) return pa - pb;
          return (a.joinedAt || 0) - (b.joinedAt || 0);
        });

        if (countEl) {
          countEl.textContent = `${members.length} 人在線`;
        }

        listEl.innerHTML = members.map((m) => {
          const isMe = m.uid === myUid;
          const isHost = state.hostUid === m.uid || (state.hostVaultCode && m.vaultCode === state.hostVaultCode);
          const resolvedVault = normalizeVaultCode(
            m.vaultCode || (appState.cloudProfiles && appState.cloudProfiles[m.uid]?.vaultCode) || ''
          );
          const stats = resolvedVault ? getVaultStats(resolvedVault) : { wins: 0, losses: 0 };
          const statsBadge = resolvedVault
            ? `<span class="px-1.5 py-0.5 rounded bg-amber-100/80 border border-amber-200 text-[10px] font-bold text-amber-900 shrink-0">${stats.wins}勝 ${stats.losses}敗</span>`
            : '';
          let roleBadge = '';
          let cardStyle = 'bg-white border-stone-200 text-stone-700';

          if (state.mode === 'match') {
            if (state.blackUid === m.uid || (state.blackVaultCode && m.vaultCode === state.blackVaultCode)) {
              roleBadge = '<span class="px-1.5 py-0.5 rounded bg-stone-900 text-amber-300 text-[10px] font-bold shrink-0">● 執黑</span>';
              cardStyle = 'bg-amber-50/70 border-amber-300 text-stone-900';
            } else if (state.whiteUid === m.uid || (state.whiteVaultCode && m.vaultCode === state.whiteVaultCode)) {
              roleBadge = '<span class="px-1.5 py-0.5 rounded bg-stone-100 border border-stone-300 text-stone-800 text-[10px] font-bold shrink-0">○ 執白</span>';
              cardStyle = 'bg-stone-100/80 border-stone-300 text-stone-900';
            } else {
              roleBadge = '<span class="px-1.5 py-0.5 rounded bg-stone-100 text-stone-500 text-[10px] font-semibold shrink-0">👀 觀戰</span>';
            }
          } else {
            if (state.studyControllerUid === m.uid || (state.studyControllerVaultCode && m.vaultCode === state.studyControllerVaultCode)) {
              roleBadge = '<span class="px-1.5 py-0.5 rounded bg-emerald-600 text-white text-[10px] font-bold shrink-0">🎙️ 主講</span>';
              cardStyle = 'bg-emerald-50/70 border-emerald-300 text-stone-900';
            } else {
              roleBadge = '<span class="px-1.5 py-0.5 rounded bg-stone-100 text-stone-500 text-[10px] font-semibold shrink-0">👀 旁觀</span>';
            }
          }

          return `
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl border ${cardStyle} max-w-full shadow-2xs">
              <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
              <span class="font-bold text-xs truncate max-w-[110px]">${escapeHtml(m.name || '棋友')}${isMe ? ' (我)' : ''}</span>
              ${isHost ? '<span title="房主" class="text-[11px] shrink-0">👑</span>' : ''}
              ${statsBadge}
              ${roleBadge}
            </div>`;
        }).join('');
      }

      window.addEventListener('beforeunload', () => {
        if (state && state.id) {
          stopRoomPresenceHeartbeat(state.id);
        }
      });

      // ==================== 7. 房內即時聊天室與盤面註釋連動 ====================
      function openStudyNoteModal() {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          showToast('僅目前主講人可新增盤面註釋');
          return;
        }
        const branch = getActiveStudyBranch();
        const badge = document.getElementById('study-note-bind-badge');
        if (badge) {
          badge.textContent = `🌿 ${branch.name} · 第 ${branch.cursor} 手`;
        }
        const ta = document.getElementById('study-note-textarea');
        if (ta) ta.value = '';
        document.getElementById('study-note-modal')?.classList.remove('hidden');
        setTimeout(() => ta?.focus(), 40);
      }

      function sendStudyNoteMessage(rawText) {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          showToast('僅目前主講人可新增盤面註釋');
          return;
        }
        const text = String(rawText || '').trim().slice(0, 300);
        if (!text) {
          showToast('請輸入註釋內容');
          return;
        }
        const branch = getActiveStudyBranch();
        const msg = {
          id: generateId('note'),
          roomId: state.id,
          type: 'note',
          uid: getMyUid(),
          name: getMyNickname(),
          text,
          branchId: branch.id,
          branchName: branch.name,
          cursor: branch.cursor,
          snapshotBranch: JSON.parse(JSON.stringify(branch)),
          createdAt: Date.now()
        };

        appendRoomChatMessage(msg, false);
        persistCurrentRoomAndSync(true);

        if (useFirebase) {
          cloudSetDoc(`room_messages/${state.id}`, msg.id, msg).catch(() => {});
        }
        closeAllModals();
        showToast(`📝 已送出「${branch.name} · 第 ${branch.cursor} 手」盤面註釋`);
      }

      function jumpStudyBoardToNoteContext(msg) {
        if (!state || state.mode !== 'study') return;
        const actionTag = '📝 註釋盤面';
        const targetBranchId = msg.branchId;
        const targetCursor = Number(msg.cursor) || 0;

        if (isStudyPresenter()) {
          if (targetBranchId && state.studyBranches && state.studyBranches[targetBranchId]) {
            state.activeBranchId = targetBranchId;
            const br = state.studyBranches[targetBranchId];
            br.cursor = Math.max(0, Math.min(br.moves.length, targetCursor));
            rebuildStudyBoardAtCursor(br);
            persistCurrentRoomAndSync(true);
            updateAllRoomUI();
            showBoardFloatingBubble(`${actionTag}：已同步切換至「${br.name} · 第 ${br.cursor} 手」`);
          } else if (msg.snapshotBranch) {
            const snap = JSON.parse(JSON.stringify(msg.snapshotBranch));
            snap.cursor = Math.max(0, Math.min(snap.moves.length, targetCursor));
            state.studyBranches[snap.id] = snap;
            state.activeBranchId = snap.id;
            rebuildStudyBoardAtCursor(snap);
            persistCurrentRoomAndSync(true);
            updateAllRoomUI();
            showBoardFloatingBubble(`${actionTag}：已還原「${snap.name} · 第 ${snap.cursor} 手」`);
          }
          return;
        }

        if (targetBranchId && state.studyBranches && state.studyBranches[targetBranchId]) {
          const base = JSON.parse(JSON.stringify(state.studyBranches[targetBranchId]));
          base.cursor = Math.max(0, Math.min(base.moves.length, targetCursor));
          activateSpectatorLocalStudy(base.id, base.cursor);
          showBoardFloatingBubble(`${actionTag}：本端已跳轉至「${base.name} · 第 ${base.cursor} 手」`);
        } else if (msg.snapshotBranch) {
          const snap = JSON.parse(JSON.stringify(msg.snapshotBranch));
          snap.cursor = Math.max(0, Math.min(snap.moves.length, targetCursor));
          activateSpectatorLocalStudy(snap.id, snap.cursor, snap);
          showBoardFloatingBubble(`${actionTag}：本端已還原「${snap.name} · 第 ${snap.cursor} 手」`);
        }
      }

      function sendRoomChatMessage(rawText) {
        if (!state) return;
        const text = String(rawText || '').trim().slice(0, 200);
        if (!text) return;
        if (!useFirebase) {
          showToast('⚠️ Firebase 尚未連線，無法發送訊息');
          return;
        }
        const msg = {
          id: generateId('rc'),
          roomId: state.id,
          uid: getMyUid(),
          name: getMyNickname(),
          text,
          createdAt: Date.now()
        };

        appendRoomChatMessage(msg, false);
        persistCurrentRoomAndSync(true);

        cloudSetDoc(`room_messages/${state.id}`, msg.id, msg).catch((err) => {
          showToast(`⚠️ 房內訊息發送失敗：${formatFirebaseError(err)}`);
        });
      }

      function appendRoomChatMessage(msg, isIncoming = true) {
        if (!msg || !msg.id || renderedRoomChatIds.has(msg.id)) return;
        renderedRoomChatIds.add(msg.id);

        if (state && msg.createdAt && msg.createdAt > (state.lastActivityAt || 0)) {
          state.lastActivityAt = msg.createdAt;
          if (appState.rooms[state.id]) {
            appState.rooms[state.id].lastActivityAt = msg.createdAt;
          }
        }

        const box = document.getElementById('room-chat-messages');
        if (!box) return;
        const isMe = msg.uid === getMyUid();
        const isSystem = msg.uid === 'system';
        const timeStr = new Date(msg.createdAt || Date.now()).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        const wrapper = document.createElement('div');
        if (isSystem) {
          wrapper.className = 'text-center my-1';
          wrapper.innerHTML = `<span class="inline-block px-2.5 py-0.5 rounded-full bg-amber-100/80 text-amber-900 text-[11px] font-medium">${escapeHtml(msg.text)}</span>`;
        } else if (msg.type === 'note') {
          const bindLabel = `🌿 ${escapeHtml(msg.branchName || '主線')} · 第 ${Number(msg.cursor) || 0} 手`;
          wrapper.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'}`;
          wrapper.innerHTML = `
            <div class="text-[10px] text-stone-400 mb-0.5 px-1">📝 ${escapeHtml(msg.name || '主講人')} · ${timeStr}</div>
            <div class="p-2.5 rounded-2xl max-w-[92%] space-y-1.5 shadow-2xs ${isMe ? 'bg-indigo-950 text-white rounded-tr-xs' : 'bg-indigo-50 border border-indigo-300 text-stone-900 rounded-tl-xs'}">
              <div class="flex items-center justify-between gap-2 text-[11px] font-bold ${isMe ? 'text-indigo-300' : 'text-indigo-800'}">
                <span>${bindLabel}</span>
              </div>
              <div class="text-xs leading-relaxed break-words whitespace-pre-wrap ${isMe ? 'text-indigo-50' : 'text-stone-800'}">${escapeHtml(msg.text || '')}</div>
              <button type="button" class="note-jump-btn w-full py-1.5 px-3 rounded-xl font-bold text-xs transition flex items-center justify-center gap-1 ${isMe ? 'bg-indigo-600 hover:bg-indigo-500 text-white' : 'bg-white hover:bg-indigo-100 border border-indigo-300 text-indigo-900'}">
                🧭 跳轉至此註釋盤面
              </button>
            </div>`;
          const jumpBtn = wrapper.querySelector('.note-jump-btn');
          jumpBtn?.addEventListener('click', () => {
            if (state && state.mode === 'study') {
              jumpStudyBoardToNoteContext(msg);
            }
          });
        } else {
          wrapper.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'}`;
          wrapper.innerHTML = `
            <div class="text-[10px] text-stone-400 mb-0.5 px-1">${escapeHtml(msg.name || '棋友')} · ${timeStr}</div>
            <div class="px-3 py-1.5 rounded-2xl max-w-[88%] break-words ${isMe ? 'bg-stone-800 text-white rounded-tr-xs' : 'bg-white border border-stone-200 text-stone-800 rounded-tl-xs'}">
              ${escapeHtml(msg.text)}
            </div>`;
        }
        box.appendChild(wrapper);
        box.scrollTop = box.scrollHeight;

        if (appState.mobileRoomTab !== 'chat') {
          document.getElementById('mobile-chat-unread-dot')?.classList.remove('hidden');
        }
      }

      function postSystemRoomNotice(text) {
        if (!state) return;
        const msg = {
          id: generateId('sys'),
          roomId: state.id,
          uid: 'system',
          name: '系統',
          text,
          createdAt: Date.now()
        };
        appendRoomChatMessage(msg, false);
        if (useFirebase) {
          cloudSetDoc(`room_messages/${state.id}`, msg.id, msg).catch(() => {});
        }
      }

      // ==================== 8. 雙人對弈邏輯（入座、先搶先贏開新局、悔棋、棋鐘） ====================
      function getMyRole() {
        if (!state) return 'S';
        const uid = getMyUid();
        const vault = getMyVaultCode();
        if (state.blackUid === uid || (state.blackVaultCode && vault && state.blackVaultCode === vault)) return 'B';
        if (state.whiteUid === uid || (state.whiteVaultCode && vault && state.whiteVaultCode === vault)) return 'W';
        return 'S';
      }

      function claimSeat(color) {
        if (!state || state.mode !== 'match') return;
        if (state.status === 'finished') {
          showToast('本局已結束，請先點擊「開新棋局」開放席位');
          return;
        }
        if (isRoomWaitExpired(state, Date.now())) {
          expireAndRemoveWaitingRoom(state);
          return;
        }
        if (!useFirebase || !rtdb) {
          showToast('❌ Firebase 尚未連線，無法入座');
          return;
        }
        const uid = getMyUid();
        const vault = getMyVaultCode();
        const name = getMyNickname();

        const roomRef = getCloudRef(`rooms/${state.id}`);
        let abortReason = '';

        roomRef
          .transaction((raw) => {
            if (!raw) return raw;
            const data = normalizeRoomFromRemote(raw);
            if (data.status === 'finished') {
              abortReason = 'FINISHED';
              return;
            }
            if (isRoomWaitExpired(data, Date.now())) {
              abortReason = 'EXPIRED';
              return;
            }
            const isMyBlack = data.blackUid === uid || (data.blackVaultCode && vault && data.blackVaultCode === vault);
            const isMyWhite = data.whiteUid === uid || (data.whiteVaultCode && vault && data.whiteVaultCode === vault);
            if (color === 'B') {
              if (data.blackUid && !isMyBlack) {
                abortReason = 'TAKEN';
                return;
              }
              if (isMyWhite) { data.whiteUid = null; data.whiteVaultCode = null; data.whiteName = ''; }
              data.blackUid = uid; data.blackVaultCode = vault; data.blackName = name;
            } else if (color === 'W') {
              if (data.whiteUid && !isMyWhite) {
                abortReason = 'TAKEN';
                return;
              }
              if (isMyBlack) { data.blackUid = null; data.blackVaultCode = null; data.blackName = ''; }
              data.whiteUid = uid; data.whiteVaultCode = vault; data.whiteName = name;
            }
            const now = Date.now();
            if (data.blackUid && data.whiteUid && data.status === 'waiting') {
              data.status = 'playing';
              data.waitDeadlineAt = 0;
              data.lastTickAt = now;
            }
            data.updatedAt = now;
            data.lastActivityAt = now;
            return sanitizeForRtdb(serializeRoomForFirestore(data));
          })
          .then((res) => {
            if (!res.committed) {
              if (abortReason === 'TAKEN') {
                showToast('手慢一步！該席位已被其他棋友搶先入座');
              } else if (abortReason === 'FINISHED') {
                showToast('本局已結束，請先開啟新棋局');
              } else if (abortReason === 'EXPIRED') {
                expireAndRemoveWaitingRoom(state);
              }
              return;
            }
            const updated = normalizeRoomFromRemote(res.snapshot.val());
            if (!updated) return;
            appState.spectatorLocalMatch = null;
            syncVaultProfileToCloud(vault, uid, name);
            applyIncomingRoomSnapshot(updated);
            postSystemRoomNotice(`${name} 搶先入座${color === 'B' ? '執黑' : '執白'}！`);
            if (updated.status === 'playing') {
              postSystemRoomNotice('黑白雙方皆已就座，對局正式開始！');
            }
          })
          .catch((err) => {
            showToast(`入座失敗：${formatFirebaseError(err)}`);
          });
      }

      function leaveSeat(color) {
        if (!state || state.mode !== 'match') return;
        if (state.status === 'playing' && (state.moves || []).length > 0) {
          showToast('對局進行中不可直接離座，請使用認輸或協議重開');
          return;
        }
        const curRole = getMyRole();
        if (color === 'B' && curRole === 'B') {
          state.blackUid = null;
          state.blackVaultCode = null;
          state.blackName = '';
          state.status = 'waiting';
          postSystemRoomNotice(`${getMyNickname()} 離開了黑方席位`);
        } else if (color === 'W' && curRole === 'W') {
          state.whiteUid = null;
          state.whiteVaultCode = null;
          state.whiteName = '';
          state.status = 'waiting';
          postSystemRoomNotice(`${getMyNickname()} 離開了白方席位`);
        }
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
      }

      function handleMatchBoardTap(x, y) {
        if (!state || state.mode !== 'match') return;
        const role = getMyRole();
        if (role === 'S' || appState.spectatorLocalMatch) {
          handleMatchSpectatorBoardTap(x, y);
          return;
        }
        if (state.status === 'finished') {
          showToast('本局已結束（可點擊下方「🌿 本地變化圖」進行覆盤推演）');
          return;
        }
        if (!state.blackUid || !state.whiteUid) {
          showToast('請等待黑白雙方皆入座後開始對弈');
          return;
        }
        if (state.turn !== role) {
          showToast('目前輪到對手落子（可點擊下方「🌿 本地變化圖」先行推演）');
          return;
        }

        // 連點同一交叉點僅保持預覽狀態，必須透過「確認落子」按鈕送出
        if (appState.pendingMove && appState.pendingMove.x === x && appState.pendingMove.y === y) {
          return;
        }

        const colorNum = role === 'B' ? 1 : 2;
        const check = tryApplyMoveOnBoard(state.board, x, y, colorNum, state.previousBoardHash);
        if (!check.ok) {
          showToast(check.reason);
          return;
        }

        appState.pendingMove = { x, y };
        updateMatchPrimaryActionBar();
        drawBoard();
      }

      function confirmPendingMatchMove() {
        if (!state || state.mode !== 'match' || !appState.pendingMove) return;
        const { x, y } = appState.pendingMove;
        appState.pendingMove = null;
        const role = getMyRole();
        if (role === 'S' || appState.spectatorLocalMatch || state.turn !== role || state.status === 'finished') {
          updateMatchPrimaryActionBar();
          drawBoard();
          return;
        }

        const colorNum = role === 'B' ? 1 : 2;
        const res = tryApplyMoveOnBoard(state.board, x, y, colorNum, state.previousBoardHash);
        if (!res.ok) {
          showToast(res.reason);
          updateMatchPrimaryActionBar();
          drawBoard();
          return;
        }

        commitClockAfterMove(role);

        state.status = 'playing';
        state.board = res.board;
        state.previousBoardHash = res.hash;
        state.captures[role] = (state.captures[role] || 0) + res.captured;
        state.moves.push({
          color: role,
          x,
          y,
          coord: getCoordLabel(x, y, state.boardSize)
        });
        state.consecutivePasses = 0;
        state.turn = role === 'B' ? 'W' : 'B';
        state.pendingRequest = null;

        playStoneSound();
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
      }

      function cancelPendingMatchMove() {
        appState.pendingMove = null;
        updateMatchPrimaryActionBar();
        drawBoard();
      }

      function handleMatchPass() {
        if (!state || state.mode !== 'match') return;
        const role = getMyRole();
        if (role === 'S') {
          showToast('觀戰者無法虛手');
          return;
        }
        if (appState.spectatorLocalMatch) {
          showToast('請先點選「回到對局實況」再執行虛手');
          return;
        }
        if (state.status === 'finished') return;
        if (!state.blackUid || !state.whiteUid) {
          showToast('等待雙方入座後才可進行對弈');
          return;
        }
        if (state.turn !== role) {
          showToast('目前輪到對手回合');
          return;
        }

        commitClockAfterMove(role);
        appState.pendingMove = null;
        state.status = 'playing';
        state.moves.push({ color: role, x: -1, y: -1, pass: true, coord: '虛手' });
        state.consecutivePasses = (state.consecutivePasses || 0) + 1;
        state.turn = role === 'B' ? 'W' : 'B';

        const who = role === 'B' ? '黑方' : '白方';
        showBoardFloatingBubble(`✋ ${who}選擇虛手 (Pass)`);
        postSystemRoomNotice(`${who}虛手 (Pass)`);

        if (state.consecutivePasses >= 2) {
          finishMatchByScoring();
        } else {
          persistCurrentRoomAndSync(true);
          updateAllRoomUI();
        }
      }

      function finishMatchByScoring() {
        if (!state) return;
        const komi = state.boardSize === 19 ? 7.5 : 5.5;
        const score = computeChineseScore(state.board, komi);
        state.status = 'finished';
        state.result = {
          winner: score.winner,
          reason: `雙方連續虛手數子：黑 ${score.blackArea} 子 vs 白 ${score.whiteArea} + 貼目 ${komi} = ${score.whiteTotal} 子，${score.winner === 'B' ? '黑勝' : '白勝'} ${score.margin} 子`
        };
        settleFinishedMatchVaultStats();
        postSystemRoomNotice(`終局結果：${state.result.reason}`);
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
      }

      function handleResign() {
        if (!state || state.mode !== 'match') return;
        const role = getMyRole();
        if (role === 'S') {
          showToast('觀戰者無法操作認輸');
          return;
        }
        if (state.status === 'finished') return;
        openCustomConfirm('確定要認輸結束本局嗎？', () => {
          if (!state || state.status === 'finished') return;
          const winner = role === 'B' ? 'W' : 'B';
          const loserName = role === 'B' ? '黑方' : '白方';
          appState.spectatorLocalMatch = null;
          state.status = 'finished';
          state.result = {
            winner,
            reason: `${loserName}中盤認輸，${winner === 'B' ? '黑方' : '白方'}勝`
          };
          settleFinishedMatchVaultStats();
          postSystemRoomNotice(`終局結果：${state.result.reason}`);
          persistCurrentRoomAndSync(true);
          updateAllRoomUI();
        }, '確認認輸');
      }

      function handleScoreEstimate() {
        if (!state) return;
        const komi = state.boardSize === 19 ? 7.5 : 5.5;
        const viewBoard =
          state.mode === 'match' && appState.spectatorLocalMatch
            ? getMatchSpectatorRenderState().board
            : state.board;
        const s = computeChineseScore(viewBoard, komi);
        const prefix = state.mode === 'match' && appState.spectatorLocalMatch ? '本地變化盤面參考' : '目前盤面參考';
        showToast(`${prefix}（貼${komi}目）：黑 ${s.blackArea} 子 / 白 ${s.whiteTotal} 子（${s.winner === 'B' ? '黑' : '白'}領先 ${s.margin} 子）`, 4200);
      }

      function requestUndo() {
        if (!state || state.mode !== 'match') return;
        const role = getMyRole();
        if (role === 'S') {
          showToast('觀戰者無法請求悔棋');
          return;
        }
        if (state.status === 'finished') {
          showToast('對局已結束');
          return;
        }
        if (!(state.moves || []).length) {
          showToast('目前尚未落子');
          return;
        }
        state.pendingRequest = {
          type: 'undo',
          fromRole: role,
          fromUid: getMyUid(),
          fromName: getMyNickname()
        };
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
        showToast('已向對手發送悔棋請求，等待對方同意');
      }

      function executeUndoMove() {
        if (!state || !(state.moves || []).length) return;
        state.moves.pop();
        const size = state.boardSize;
        let board = createEmptyBoard(size);
        let captures = { B: 0, W: 0 };
        let prevHash = '';
        for (const m of state.moves) {
          if (m.pass || m.x < 0) continue;
          const cNum = m.color === 'B' ? 1 : 2;
          const step = tryApplyMoveOnBoard(board, m.x, m.y, cNum, '');
          if (step.ok) {
            prevHash = boardToHash(board);
            board = step.board;
            captures[m.color] += step.captured;
          }
        }
        state.board = board;
        state.captures = captures;
        state.previousBoardHash = prevHash;
        state.consecutivePasses = 0;
        const last = state.moves[state.moves.length - 1];
        state.turn = last ? (last.color === 'B' ? 'W' : 'B') : 'B';
        state.pendingRequest = null;
        appState.pendingMove = null;
        if (appState.spectatorLocalMatch && appState.spectatorLocalMatch.branches?.live_main) {
          const liveBr = appState.spectatorLocalMatch.branches.live_main;
          liveBr.moves = JSON.parse(JSON.stringify(state.moves || []));
          liveBr.cursor = Math.min(liveBr.cursor, liveBr.moves.length);
        }
      }

      function requestOrExecuteNewMatch(mode = 'open_new') {
        if (!state || state.mode !== 'match') return;
        const role = getMyRole();
        const isHost = isRoomHost(state);

        if (state.status !== 'finished' && role === 'S') {
          showToast('對局進行中，觀戰者不可開新局');
          return;
        }

        if (state.status === 'finished' && role === 'S' && !isHost) {
          showToast('請等待房主或上一局棋手開啟新棋局');
          return;
        }

        if (mode === 'swap') {
          if (state.blackUid && state.whiteUid && state.blackUid !== state.whiteUid) {
            state.pendingRequest = {
              type: 'rematch_swap',
              fromRole: role,
              fromUid: getMyUid(),
              fromName: getMyNickname()
            };
            persistCurrentRoomAndSync(true);
            updateAllRoomUI();
            showToast('已發送交換黑白再戰邀請，等待對手確認');
            return;
          }
          resetMatchBoardState('swap');
          return;
        }

        if (state.status === 'finished') {
          resetMatchBoardState('open_new');
          return;
        }

        openCustomConfirm('確定要重新開始本局嗎？', () => resetMatchBoardState('keep'), '開新對局');
      }

      function resetMatchBoardState(seatPolicy) {
        if (!state) return;
        const now = Date.now();
        const size = state.boardSize;

        if (seatPolicy === 'swap') {
          const oldB = state.blackUid;
          const oldBVault = state.blackVaultCode || null;
          const oldBName = state.blackName;
          state.blackUid = state.whiteUid;
          state.blackVaultCode = state.whiteVaultCode || null;
          state.blackName = state.whiteName;
          state.whiteUid = oldB;
          state.whiteVaultCode = oldBVault;
          state.whiteName = oldBName;
          postSystemRoomNotice('雙方交換黑白，開啟新對局！');
        } else if (seatPolicy === 'open_new') {
          const hostUid = state.hostUid;
          const hostVault = state.hostVaultCode;
          const blackIsHost = (hostUid && state.blackUid === hostUid) || (hostVault && state.blackVaultCode === hostVault);
          const whiteIsHost = (hostUid && state.whiteUid === hostUid) || (hostVault && state.whiteVaultCode === hostVault);
          if (blackIsHost) {
            state.whiteUid = null;
            state.whiteVaultCode = null;
            state.whiteName = '';
          } else if (whiteIsHost) {
            state.blackUid = null;
            state.blackVaultCode = null;
            state.blackName = '';
          } else {
            state.blackUid = null;
            state.blackVaultCode = null;
            state.blackName = '';
            state.whiteUid = null;
            state.whiteVaultCode = null;
            state.whiteName = '';
          }
          postSystemRoomNotice('🆕 新棋局已開啟！非房主席位已開放，歡迎棋友點擊入座對弈（先搶先贏）！');
        } else {
          postSystemRoomNotice('重新開啟新對局');
        }

        state.board = createEmptyBoard(size);
        state.moves = [];
        state.captures = { B: 0, W: 0 };
        state.previousBoardHash = '';
        state.consecutivePasses = 0;
        state.turn = 'B';
        state.result = null;
        state.statsRecorded = false;
        state.pendingRequest = null;
        state.status = state.blackUid && state.whiteUid ? 'playing' : 'waiting';
        if (state.status === 'waiting' && (Number(state.waitTimeoutSeconds) || 0) > 0) {
          state.waitDeadlineAt = now + Number(state.waitTimeoutSeconds) * 1000;
        } else {
          state.waitDeadlineAt = 0;
        }
        state.clocks = {
          B: { main: state.mainTime, byoLeft: state.byoyomiSeconds, periodsLeft: state.byoyomiPeriods, inByo: state.mainTime === 0 && state.byoyomiSeconds > 0 },
          W: { main: state.mainTime, byoLeft: state.byoyomiSeconds, periodsLeft: state.byoyomiPeriods, inByo: state.mainTime === 0 && state.byoyomiSeconds > 0 }
        };
        state.lastTickAt = now;
        appState.pendingMove = null;
        appState.spectatorLocalMatch = null;
        appState.lastFinishedBannerId = '';

        closeAllModals();
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
      }

      function respondToMatchRequest(accept) {
        if (!state || !state.pendingRequest) return;
        const req = state.pendingRequest;
        const role = getMyRole();
        if (role === 'S' || req.fromUid === getMyUid()) return;

        if (!accept) {
          state.pendingRequest = null;
          postSystemRoomNotice(`${getMyNickname()} 婉拒了${req.type === 'undo' ? '悔棋' : '再戰'}請求`);
          persistCurrentRoomAndSync(true);
          updateAllRoomUI();
          return;
        }

        if (req.type === 'undo') {
          executeUndoMove();
          postSystemRoomNotice(`${getMyNickname()} 同意了悔棋請求`);
          persistCurrentRoomAndSync(true);
          updateAllRoomUI();
        } else if (req.type === 'rematch_swap') {
          resetMatchBoardState('swap');
        }
      }

      function getLiveClockState(color) {
        if (!state || !state.clocks || !state.clocks[color]) {
          return { main: 0, byoLeft: 0, periodsLeft: 0, inByo: false, expired: false };
        }
        const c = { ...state.clocks[color] };
        if (state.mainTime === 0 && state.byoyomiSeconds === 0) {
          return { ...c, expired: false };
        }
        if (state.status !== 'playing' || state.turn !== color || !state.blackUid || !state.whiteUid) {
          return { ...c, expired: false };
        }

        const elapsed = Math.max(0, (Date.now() - (state.lastTickAt || Date.now())) / 1000);
        if (!c.inByo) {
          if (c.main > elapsed) {
            c.main -= elapsed;
            return { ...c, expired: false };
          }
          const overflow = elapsed - c.main;
          c.main = 0;
          if (!state.byoyomiSeconds || !state.byoyomiPeriods) {
            return { ...c, expired: true };
          }
          c.inByo = true;
          const periodsUsed = Math.floor(overflow / state.byoyomiSeconds);
          if (periodsUsed >= c.periodsLeft) {
            c.periodsLeft = 0;
            c.byoLeft = 0;
            return { ...c, expired: true };
          }
          c.periodsLeft -= periodsUsed;
          c.byoLeft = state.byoyomiSeconds - (overflow % state.byoyomiSeconds);
          return { ...c, expired: false };
        } else {
          if (!state.byoyomiSeconds || !state.byoyomiPeriods) {
            return { ...c, expired: true };
          }
          const periodsUsed = Math.floor(elapsed / state.byoyomiSeconds);
          if (periodsUsed >= c.periodsLeft) {
            c.periodsLeft = 0;
            c.byoLeft = 0;
            return { ...c, expired: true };
          }
          c.periodsLeft -= periodsUsed;
          c.byoLeft = state.byoyomiSeconds - (elapsed % state.byoyomiSeconds);
          return { ...c, expired: false };
        }
      }

      function commitClockAfterMove(color) {
        if (!state || (state.mainTime === 0 && state.byoyomiSeconds === 0)) {
          if (state) state.lastTickAt = Date.now();
          return;
        }
        const live = getLiveClockState(color);
        state.clocks[color] = {
          main: live.main,
          byoLeft: live.inByo ? state.byoyomiSeconds : live.byoLeft,
          periodsLeft: live.periodsLeft,
          inByo: live.inByo
        };
        state.lastTickAt = Date.now();
      }

      setInterval(() => {
        if (!state || state.mode !== 'match') return;
        updateClockDisplayOnly();
      }, 250);

      setInterval(() => {
        sweepExpiredWaitingRooms();
        updateWaitCountdownsUI();
      }, 1000);

      function updateClockDisplayOnly() {
        if (!state || state.mode !== 'match') return;
        const isPlayingMatch = state.status === 'playing' && !!state.blackUid && !!state.whiteUid;
        const myRole = getMyRole();
        const turnHint = document.getElementById('turn-sub-hint');

        ['B', 'W'].forEach((col) => {
          const isBlack = col === 'B';
          const el = document.getElementById(isBlack ? 'black-clock-display' : 'white-clock-display');
          const byoEl = document.getElementById(isBlack ? 'black-byoyomi-display' : 'white-byoyomi-display');
          const cardEl = document.getElementById(isBlack ? 'black-player-card' : 'white-player-card');
          const hudPill = document.getElementById(isBlack ? 'hud-black-pill' : 'hud-white-pill');
          const hudClock = document.getElementById(isBlack ? 'hud-black-clock' : 'hud-white-clock');
          const hudByo = document.getElementById(isBlack ? 'hud-black-byo' : 'hud-white-byo');

          const isActiveTurn = isPlayingMatch && state.turn === col;
          let clockText = '無限';
          let byoText = '自由時間';
          let hudByoShort = '';
          let isByoWarning = false;
          let isUrgent = false;

          if (state.mainTime === 0 && state.byoyomiSeconds === 0) {
            clockText = '無限';
            byoText = '自由時間';
          } else {
            const live = getLiveClockState(col);
            if (live.inByo) {
              const byoSecCeil = Math.ceil(live.byoLeft);
              clockText = byoSecCeil > 120 ? formatSeconds(byoSecCeil) : `${byoSecCeil}秒`;
              byoText = `讀秒剩 ${live.periodsLeft} 次`;
              hudByoShort = `剩${live.periodsLeft}次`;
              isByoWarning = isActiveTurn;
              isUrgent = isActiveTurn && byoSecCeil <= 10 && byoSecCeil > 0;

              if (isActiveTurn && myRole === col && byoSecCeil <= 5 && byoSecCeil >= 1) {
                const tickKey = `${state.id}_${col}_${(state.moves || []).length}_byo_${live.periodsLeft}_${byoSecCeil}`;
                if (appState.lastClockTickAudioKey !== tickKey) {
                  appState.lastClockTickAudioKey = tickKey;
                  playClockTickSound(byoSecCeil === 1);
                }
              }
            } else {
              const mainSecCeil = Math.ceil(live.main);
              clockText = formatSeconds(live.main);
              byoText = state.byoyomiSeconds ? `讀秒 ${formatByoyomiShortLabel(state.byoyomiSeconds)}×${state.byoyomiPeriods}` : '包乾制';
              isUrgent = isActiveTurn && !state.byoyomiSeconds && mainSecCeil <= 10 && mainSecCeil > 0;

              if (isActiveTurn && myRole === col && !state.byoyomiSeconds && mainSecCeil <= 5 && mainSecCeil >= 1) {
                const tickKey = `${state.id}_${col}_${(state.moves || []).length}_main_${mainSecCeil}`;
                if (appState.lastClockTickAudioKey !== tickKey) {
                  appState.lastClockTickAudioKey = tickKey;
                  playClockTickSound(mainSecCeil === 1);
                }
              }
            }

            if (live.expired && state.status === 'playing' && myRole !== 'S') {
              const winner = col === 'B' ? 'W' : 'B';
              appState.spectatorLocalMatch = null;
              state.status = 'finished';
              state.result = {
                winner,
                reason: `${isBlack ? '黑方' : '白方'}超時負，${winner === 'B' ? '黑方' : '白方'}勝`
              };
              settleFinishedMatchVaultStats();
              postSystemRoomNotice(`終局結果：${state.result.reason}`);
              persistCurrentRoomAndSync(true);
              updateAllRoomUI();
              return;
            }
          }

          if (el) {
            el.textContent = clockText;
            if (isUrgent) {
              el.className = isBlack
                ? 'font-mono font-black text-base sm:text-lg text-rose-400 animate-pulse'
                : 'font-mono font-black text-base sm:text-lg text-rose-600 animate-pulse';
            } else if (isByoWarning) {
              el.className = isBlack
                ? 'font-mono font-black text-base sm:text-lg text-rose-400'
                : 'font-mono font-black text-base sm:text-lg text-rose-600';
            } else {
              el.className = isBlack
                ? 'font-mono font-black text-base sm:text-lg text-amber-300'
                : 'font-mono font-black text-base sm:text-lg text-stone-900';
            }
          }
          if (byoEl) {
            byoEl.textContent = byoText;
            byoEl.className = isUrgent || isByoWarning
              ? (isBlack ? 'text-[10px] font-bold text-rose-300' : 'text-[10px] font-bold text-rose-600')
              : (isBlack ? 'text-[10px] text-stone-400' : 'text-[10px] text-stone-500');
          }
          if (cardEl) {
            if (isBlack) {
              cardEl.className = isUrgent
                ? 'p-2.5 rounded-xl border-2 border-rose-500 bg-stone-900 text-white space-y-1.5'
                : isActiveTurn
                  ? 'p-2.5 rounded-xl border-2 border-amber-400 bg-stone-900 text-white space-y-1.5'
                  : 'p-2.5 rounded-xl border-2 border-stone-800 bg-stone-900 text-white space-y-1.5';
            } else {
              cardEl.className = isUrgent
                ? 'p-2.5 rounded-xl border-2 border-rose-500 bg-rose-50/40 text-stone-900 space-y-1.5'
                : isActiveTurn
                  ? 'p-2.5 rounded-xl border-2 border-amber-500 bg-amber-50/40 text-stone-900 space-y-1.5'
                  : 'p-2.5 rounded-xl border-2 border-stone-300 bg-stone-50 text-stone-900 space-y-1.5';
            }
          }

          if (hudClock) hudClock.textContent = clockText;
          if (hudByo) hudByo.textContent = hudByoShort;
          if (hudPill) {
            if (isUrgent) {
              hudPill.className = 'flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-rose-600 text-white ring-2 ring-rose-400 animate-pulse min-w-0 transition-colors';
            } else if (isActiveTurn) {
              hudPill.className = isBlack
                ? `flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-stone-900 ${isByoWarning ? 'text-rose-300 ring-1 ring-rose-400' : 'text-amber-300 ring-1 ring-amber-400'} min-w-0 transition-colors`
                : `flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-amber-100 ${isByoWarning ? 'text-rose-700 ring-1 ring-rose-500' : 'text-stone-950 ring-1 ring-amber-500'} min-w-0 transition-colors`;
            } else {
              hudPill.className = 'flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-stone-100 text-stone-600 min-w-0 transition-colors';
            }
          }

          if (isActiveTurn && turnHint && myRole !== 'S' && !appState.spectatorLocalMatch) {
            if (isUrgent) {
              turnHint.textContent = `🔥 急迫 ${clockText} (${byoText})`;
              turnHint.className = 'text-[11px] sm:text-xs text-rose-600 font-black animate-pulse shrink-0';
            } else if (isByoWarning) {
              turnHint.textContent = `⏱️ 讀秒 ${clockText} (${byoText})`;
              turnHint.className = 'text-[11px] sm:text-xs text-amber-700 font-bold shrink-0';
            } else {
              turnHint.textContent = myRole === col ? '輪到您落子' : '等待對手';
              turnHint.className = 'text-[11px] sm:text-xs text-stone-500 shrink-0';
            }
          }
        });
      }

      // ==================== 8.5 對弈室本地變化圖與手數導覽控制（對弈者與觀眾皆可使用） ====================
      function activateSpectatorLocalMatch(branchId = 'live_main', cursorOverride = null, explicitLocal = false) {
        if (!state || state.mode !== 'match') return;
        const liveMoves = JSON.parse(JSON.stringify(state.moves || []));
        if (!appState.spectatorLocalMatch) {
          appState.spectatorLocalMatch = {
            explicitLocal: !!explicitLocal,
            activeBranchId: 'live_main',
            branches: {
              live_main: {
                id: 'live_main',
                name: '實況主線',
                isLiveClone: true,
                moves: liveMoves,
                cursor: cursorOverride !== null ? cursorOverride : liveMoves.length
              }
            }
          };
        } else {
          if (explicitLocal) {
            appState.spectatorLocalMatch.explicitLocal = true;
          }
          appState.spectatorLocalMatch.branches.live_main.moves = liveMoves;
        }
        if (branchId && appState.spectatorLocalMatch.branches[branchId]) {
          appState.spectatorLocalMatch.activeBranchId = branchId;
        }
        const activeBr = appState.spectatorLocalMatch.branches[appState.spectatorLocalMatch.activeBranchId];
        if (cursorOverride !== null && activeBr) {
          activeBr.cursor = Math.max(0, Math.min(activeBr.moves.length, cursorOverride));
        }
      }

      function openPlayerMatchLocalVariation() {
        if (!state || state.mode !== 'match') return;
        appState.pendingMove = null;
        const liveLen = (state.moves || []).length;
        activateSpectatorLocalMatch('live_main', liveLen, true);
        updateAllRoomUI();
        showToast('已進入本地變化圖推演模式（僅自己可見，不影響對手）');
      }

      function syncLiveMovesIntoMatchSpectatorLocal(prevMovesLen) {
        if (!state || state.mode !== 'match' || !appState.spectatorLocalMatch) {
          return true;
        }
        const loc = appState.spectatorLocalMatch;
        const liveBr = loc.branches.live_main;
        if (!liveBr) return true;
        const wasAtLiveEnd = loc.activeBranchId === 'live_main' && liveBr.cursor >= prevMovesLen;
        liveBr.moves = JSON.parse(JSON.stringify(state.moves || []));
        if (wasAtLiveEnd) {
          liveBr.cursor = liveBr.moves.length;
          const hasCustomBranches = Object.keys(loc.branches).length > 1;
          if (!hasCustomBranches && !loc.explicitLocal && getMyRole() === 'S') {
            appState.spectatorLocalMatch = null;
          }
          return true;
        }
        return false;
      }

      function returnMatchSpectatorToLive() {
        appState.spectatorLocalMatch = null;
        appState.pendingMove = null;
        updateAllRoomUI();
        showToast('已同步回到對局最新實況');
      }

      function getMatchSpectatorRenderState() {
        const size = state.boardSize || 19;
        if (!appState.spectatorLocalMatch) {
          const moves = state.moves || [];
          return {
            isLocal: false,
            activeBranchId: 'live_main',
            branchName: '實況主線',
            cursor: moves.length,
            totalMoves: moves.length,
            board: state.board || createEmptyBoard(size),
            moves,
            turn: state.turn || 'B'
          };
        }
        const loc = appState.spectatorLocalMatch;
        const br = loc.branches[loc.activeBranchId] || loc.branches.live_main;
        const limit = Math.max(0, Math.min(br.cursor ?? br.moves.length, br.moves.length));
        let board = createEmptyBoard(size);
        let prevHash = '';
        for (let i = 0; i < limit; i++) {
          const m = br.moves[i];
          if (!m || m.pass || m.x < 0) continue;
          const cNum = m.color === 'B' ? 1 : 2;
          const res = tryApplyMoveOnBoard(board, m.x, m.y, cNum, '');
          if (res.ok) {
            prevHash = boardToHash(board);
            board = res.board;
          } else {
            board[m.y][m.x] = cNum;
          }
        }
        const slicedMoves = br.moves.slice(0, limit);
        const lastMove = slicedMoves[slicedMoves.length - 1];
        return {
          isLocal: true,
          activeBranchId: br.id,
          branchName: br.name,
          cursor: limit,
          totalMoves: br.moves.length,
          board,
          previousBoardHash: prevHash,
          moves: slicedMoves,
          turn: lastMove ? (lastMove.color === 'B' ? 'W' : 'B') : 'B'
        };
      }

      function stepMatchSpectatorCursor(delta) {
        if (!state || state.mode !== 'match') return;
        const role = getMyRole();
        if (role !== 'S' && !appState.spectatorLocalMatch) return;

        const liveMoves = state.moves || [];
        if (!appState.spectatorLocalMatch) {
          if (delta >= 0) {
            showToast('目前已是最新實況一手');
            return;
          }
          const startPos = delta === -9999 ? 0 : Math.max(0, liveMoves.length + delta);
          activateSpectatorLocalMatch('live_main', startPos, false);
          updateAllRoomUI();
          return;
        }

        const loc = appState.spectatorLocalMatch;
        const br = loc.branches[loc.activeBranchId] || loc.branches.live_main;
        const total = br.moves.length;
        let nextCursor = br.cursor;
        if (delta === -9999) nextCursor = 0;
        else if (delta === 9999) nextCursor = total;
        else nextCursor = Math.max(0, Math.min(total, br.cursor + delta));

        if (nextCursor === br.cursor) return;
        br.cursor = nextCursor;
        if (delta > 0) playStoneSound();

        if (
          br.id === 'live_main' &&
          br.cursor === total &&
          Object.keys(loc.branches).length === 1 &&
          !loc.explicitLocal &&
          role === 'S'
        ) {
          appState.spectatorLocalMatch = null;
        }
        updateAllRoomUI();
      }

      function undoMatchSpectatorLocalMove() {
        if (!state || state.mode !== 'match') return;
        const role = getMyRole();
        if (role !== 'S' && !appState.spectatorLocalMatch) return;

        if (!appState.spectatorLocalMatch) {
          stepMatchSpectatorCursor(-1);
          return;
        }
        const loc = appState.spectatorLocalMatch;
        const br = loc.branches[loc.activeBranchId] || loc.branches.live_main;
        if (br.id === 'live_main') {
          stepMatchSpectatorCursor(-1);
          return;
        }
        if (br.cursor <= 0) {
          showToast('目前已無可退回的手數');
          return;
        }
        br.moves = br.moves.slice(0, br.cursor - 1);
        br.cursor = br.moves.length;
        updateAllRoomUI();
      }

      function createMatchSpectatorLocalBranch() {
        if (!state || state.mode !== 'match') return;
        const curRender = getMatchSpectatorRenderState();
        activateSpectatorLocalMatch(curRender.activeBranchId, curRender.cursor, getMyRole() !== 'S');
        const loc = appState.spectatorLocalMatch;
        const curBr = loc.branches[loc.activeBranchId];
        const newId = generateId('mspec');
        const idx = Object.keys(loc.branches).length;
        loc.branches[newId] = {
          id: newId,
          name: `🌿 本地變化 ${idx}`,
          isLiveClone: false,
          moves: curBr.moves.slice(0, curBr.cursor),
          cursor: curBr.cursor
        };
        loc.activeBranchId = newId;
        updateAllRoomUI();
        showToast(`已建立「${loc.branches[newId].name}」，可點擊棋盤自由推演`);
      }

      function switchMatchSpectatorBranch(branchId) {
        if (!appState.spectatorLocalMatch || !appState.spectatorLocalMatch.branches[branchId]) return;
        const loc = appState.spectatorLocalMatch;
        loc.activeBranchId = branchId;
        const br = loc.branches[branchId];
        if (
          branchId === 'live_main' &&
          br.cursor >= br.moves.length &&
          Object.keys(loc.branches).length === 1 &&
          !loc.explicitLocal &&
          getMyRole() === 'S'
        ) {
          appState.spectatorLocalMatch = null;
        }
        updateAllRoomUI();
      }

      function deleteActiveMatchSpectatorBranch() {
        if (!appState.spectatorLocalMatch) return;
        const loc = appState.spectatorLocalMatch;
        if (loc.activeBranchId === 'live_main') return;
        delete loc.branches[loc.activeBranchId];
        loc.activeBranchId = 'live_main';
        const liveBr = loc.branches.live_main;
        if (
          liveBr &&
          liveBr.cursor >= liveBr.moves.length &&
          Object.keys(loc.branches).length === 1 &&
          !loc.explicitLocal &&
          getMyRole() === 'S'
        ) {
          appState.spectatorLocalMatch = null;
        }
        updateAllRoomUI();
        showToast('已刪除此本地變化圖');
      }

      function handleMatchSpectatorBoardTap(x, y) {
        if (!state || state.mode !== 'match') return;
        const role = getMyRole();
        if (role !== 'S' && !appState.spectatorLocalMatch) return;

        const curRender = getMatchSpectatorRenderState();
        const nextColor = curRender.turn || 'B';
        const cNum = nextColor === 'B' ? 1 : 2;
        const res = tryApplyMoveOnBoard(curRender.board, x, y, cNum, curRender.previousBoardHash || '');
        if (!res.ok) {
          showToast(res.reason);
          return;
        }

        activateSpectatorLocalMatch(curRender.activeBranchId, curRender.cursor, role !== 'S');
        const loc = appState.spectatorLocalMatch;
        let br = loc.branches[loc.activeBranchId];

        if (br.id === 'live_main' || br.cursor < br.moves.length) {
          const baseStep = br.cursor;
          const newId = generateId('mspec');
          const idx = Object.keys(loc.branches).length;
          const newBr = {
            id: newId,
            name: `🌿 本地變化 ${idx} (第${baseStep}手)`,
            isLiveClone: false,
            moves: br.moves.slice(0, baseStep),
            cursor: baseStep
          };
          loc.branches[newId] = newBr;
          loc.activeBranchId = newId;
          br = newBr;
          showToast(`已從第 ${baseStep} 手建立「${newBr.name}」`);
        }

        br.moves.push({
          color: nextColor,
          x,
          y,
          coord: getCoordLabel(x, y, state.boardSize)
        });
        br.cursor = br.moves.length;
        playStoneSound();
        updateAllRoomUI();
      }

      // ==================== 9. 擺盤研究室（單人主講權離開不自動放棄＋多線程變化圖＋觀眾本端推演） ====================
      function ensureStudyBranchesInitialized(shouldPersist = false) {
        if (!state || state.mode !== 'study') return;
        if (!state.studyBranches || typeof state.studyBranches !== 'object' || !Object.keys(state.studyBranches).length) {
          const mainId = 'branch_main';
          state.activeBranchId = mainId;
          state.studyBranches = {
            [mainId]: {
              id: mainId,
              name: '主線',
              moves: Array.isArray(state.moves) ? state.moves.slice() : [],
              cursor: Array.isArray(state.moves) ? state.moves.length : 0,
              rezeroOffset: 0,
              setupStones: []
            }
          };
          if (shouldPersist) persistCurrentRoomAndSync(false);
        }
        if (!state.activeBranchId || !state.studyBranches[state.activeBranchId]) {
          state.activeBranchId = Object.keys(state.studyBranches)[0];
        }
      }

      function getActiveStudyBranch() {
        ensureStudyBranchesInitialized(false);
        return state.studyBranches[state.activeBranchId];
      }

      function isStudyPresenter() {
        if (!state || state.mode !== 'study') return false;
        const uid = getMyUid();
        const vault = getMyVaultCode();
        if (state.studyControllerUid === uid) return true;
        if (state.studyControllerVaultCode && vault && state.studyControllerVaultCode === vault) return true;
        return false;
      }

      function activateSpectatorLocalStudy(branchId = null, cursorOverride = null, customBranchObj = null) {
        if (!state || state.mode !== 'study' || isStudyPresenter()) return;
        ensureStudyBranchesInitialized(false);
        if (!appState.spectatorLocalStudy) {
          appState.spectatorLocalStudy = {
            activeBranchId: state.activeBranchId,
            branches: JSON.parse(JSON.stringify(state.studyBranches))
          };
        } else {
          syncPresenterBranchesIntoSpectatorLocal();
        }
        const loc = appState.spectatorLocalStudy;
        if (customBranchObj && customBranchObj.id) {
          loc.branches[customBranchObj.id] = JSON.parse(JSON.stringify(customBranchObj));
        }
        if (branchId && loc.branches[branchId]) {
          loc.activeBranchId = branchId;
        }
        const activeBr = loc.branches[loc.activeBranchId] || Object.values(loc.branches)[0];
        if (activeBr) {
          loc.activeBranchId = activeBr.id;
          if (cursorOverride !== null) {
            activeBr.cursor = Math.max(0, Math.min(activeBr.moves.length, cursorOverride));
          }
        }
      }

      function syncPresenterBranchesIntoSpectatorLocal() {
        if (!appState.spectatorLocalStudy || !state || !state.studyBranches) return;
        const loc = appState.spectatorLocalStudy;
        Object.entries(state.studyBranches).forEach(([id, pBr]) => {
          if (!loc.branches[id]) {
            loc.branches[id] = JSON.parse(JSON.stringify(pBr));
          } else if (!loc.branches[id].isLocalOnly) {
            const oldCursor = loc.branches[id].cursor;
            const oldLen = loc.branches[id].moves.length;
            loc.branches[id] = JSON.parse(JSON.stringify(pBr));
            if (oldCursor < oldLen) {
              loc.branches[id].cursor = Math.min(oldCursor, pBr.moves.length);
            }
          }
        });
      }

      function returnSpectatorToPresenterLive() {
        appState.spectatorLocalStudy = null;
        updateAllRoomUI();
        showToast('已同步回到主講人最新進度');
      }

      function getStudyRenderState() {
        ensureStudyBranchesInitialized(false);
        const isPresenter = isStudyPresenter();
        if (!isPresenter && appState.spectatorLocalStudy) {
          const loc = appState.spectatorLocalStudy;
          const branch = loc.branches[loc.activeBranchId] || Object.values(loc.branches)[0];
          const computed = computeStudyBoardSnapshot(branch);
          return {
            isLocalView: true,
            branch,
            branchesMap: loc.branches,
            activeBranchId: branch.id,
            ...computed
          };
        }
        const branch = getActiveStudyBranch();
        const computed = computeStudyBoardSnapshot(branch);
        return {
          isLocalView: false,
          branch,
          branchesMap: state.studyBranches,
          activeBranchId: state.activeBranchId,
          ...computed
        };
      }

      function computeStudyBoardSnapshot(branch) {
        const size = state.boardSize || 19;
        let board = createEmptyBoard(size);
        for (const s of branch.setupStones || []) {
          if (s.x >= 0 && s.y >= 0 && s.x < size && s.y < size) {
            board[s.y][s.x] = s.color === 'B' ? 1 : 2;
          }
        }
        const limit = Math.min(branch.cursor ?? branch.moves.length, branch.moves.length);
        let prevHash = '';
        for (let i = 0; i < limit; i++) {
          const m = branch.moves[i];
          if (!m || m.pass || m.x < 0) continue;
          const cNum = m.color === 'B' ? 1 : 2;
          const res = tryApplyMoveOnBoard(board, m.x, m.y, cNum, '');
          if (res.ok) {
            prevHash = boardToHash(board);
            board = res.board;
          } else {
            board[m.y][m.x] = cNum;
          }
        }
        const slicedMoves = branch.moves.slice(0, limit);
        const lastMove = slicedMoves[slicedMoves.length - 1];
        const turn = lastMove ? (lastMove.color === 'B' ? 'W' : 'B') : 'B';
        return { board, previousBoardHash: prevHash, moves: slicedMoves, turn };
      }

      function rebuildStudyBoardAtCursor(branch) {
        const snap = computeStudyBoardSnapshot(branch);
        state.board = snap.board;
        state.previousBoardHash = snap.previousBoardHash;
        state.moves = snap.moves;
        state.turn = snap.turn;
      }

      function releaseStudyControl() {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          showToast('您目前不是主講人');
          return;
        }
        const oldName = getMyNickname();
        state.studyControllerUid = null;
        state.studyControllerVaultCode = null;
        state.studyControllerName = '';
        postSystemRoomNotice(`🏳️ ${oldName} 已放棄擺盤權，現在其他棋友可點擊「接手擺盤」`);
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
      }

      function takeOverStudyControl() {
        if (!state || state.mode !== 'study') return;
        if (state.studyControllerUid && !isStudyPresenter()) {
          showToast(`目前由「${state.studyControllerName || '主持人'}」主講中，需等其放棄擺盤權後才可接手`);
          return;
        }
        appState.spectatorLocalStudy = null;
        state.studyControllerUid = getMyUid();
        state.studyControllerVaultCode = getMyVaultCode();
        state.studyControllerName = getMyNickname();
        syncVaultProfileToCloud(state.studyControllerVaultCode, state.studyControllerUid, state.studyControllerName);
        postSystemRoomNotice(`🎙️ ${state.studyControllerName} 接手了擺盤主講權`);
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
      }

      function handleStudyBoardTap(x, y) {
        if (!state || state.mode !== 'study') return;
        if (!state.studyControllerUid) {
          appState.spectatorLocalStudy = null;
          state.studyControllerUid = getMyUid();
          state.studyControllerVaultCode = getMyVaultCode();
          state.studyControllerName = getMyNickname();
          syncVaultProfileToCloud(state.studyControllerVaultCode, state.studyControllerUid, state.studyControllerName);
          postSystemRoomNotice(`🎙️ ${state.studyControllerName} 接手了擺盤主講權`);
        } else if (!isStudyPresenter()) {
          handleSpectatorStudyBoardTap(x, y);
          return;
        }

        const branch = getActiveStudyBranch();
        if (appState.studyToolMode === 'setup') {
          const targetColor = appState.studySetupColor;
          const activeMoves = (branch.moves || []).slice(0, branch.cursor);
          const hasMoveAtPt = activeMoves.some((m) => !m.pass && m.x === x && m.y === y);
          if (hasMoveAtPt) {
            const snap = computeStudyBoardSnapshot(branch);
            const nextSetup = [];
            for (let sy = 0; sy < snap.board.length; sy++) {
              for (let sx = 0; sx < snap.board.length; sx++) {
                const v = snap.board[sy][sx];
                if (v === 1 || v === 2) {
                  nextSetup.push({ x: sx, y: sy, color: v === 1 ? 'B' : 'W' });
                }
              }
            }
            branch.setupStones = nextSetup;
            branch.moves = [];
            branch.cursor = 0;
            branch.rezeroOffset = 0;
          } else {
            branch.moves = activeMoves;
          }
          branch.setupStones = (branch.setupStones || []).filter((s) => !(s.x === x && s.y === y));
          if (targetColor === 'B' || targetColor === 'W') {
            branch.setupStones.push({ x, y, color: targetColor });
            playStoneSound();
          }
          rebuildStudyBoardAtCursor(branch);
          persistCurrentRoomAndSync(true);
          updateAllRoomUI();
          return;
        }

        rebuildStudyBoardAtCursor(branch);
        const nextColor = state.turn || 'B';
        const cNum = nextColor === 'B' ? 1 : 2;
        const res = tryApplyMoveOnBoard(state.board, x, y, cNum, state.previousBoardHash);
        if (!res.ok) {
          showToast(res.reason);
          return;
        }

        if (branch.cursor < branch.moves.length) {
          const baseStep = branch.cursor;
          const newId = generateId('branch');
          const count = Object.keys(state.studyBranches).length + 1;
          const newBranch = {
            id: newId,
            name: `變化圖 ${count} (第${baseStep}手)`,
            moves: branch.moves.slice(0, baseStep),
            cursor: baseStep,
            rezeroOffset: branch.rezeroOffset || 0,
            setupStones: JSON.parse(JSON.stringify(branch.setupStones || []))
          };
          newBranch.moves.push({
            color: nextColor,
            x,
            y,
            coord: getCoordLabel(x, y, state.boardSize)
          });
          newBranch.cursor = newBranch.moves.length;
          state.studyBranches[newId] = newBranch;
          state.activeBranchId = newId;
          rebuildStudyBoardAtCursor(newBranch);
          showToast(`已從第 ${baseStep} 手建立「${newBranch.name}」`);
        } else {
          branch.moves.push({
            color: nextColor,
            x,
            y,
            coord: getCoordLabel(x, y, state.boardSize)
          });
          branch.cursor = branch.moves.length;
          rebuildStudyBoardAtCursor(branch);
        }

        playStoneSound();
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
      }

      function handleSpectatorStudyBoardTap(x, y) {
        const renderInfo = getStudyRenderState();
        const nextColor = renderInfo.turn || 'B';
        const cNum = nextColor === 'B' ? 1 : 2;
        const res = tryApplyMoveOnBoard(renderInfo.board, x, y, cNum, renderInfo.previousBoardHash);
        if (!res.ok) {
          showToast(res.reason);
          return;
        }

        activateSpectatorLocalStudy(renderInfo.activeBranchId, renderInfo.branch.cursor);
        const loc = appState.spectatorLocalStudy;
        let br = loc.branches[loc.activeBranchId];

        if (!br.isLocalOnly || br.cursor < br.moves.length) {
          const baseStep = br.cursor;
          const newId = generateId('spec_branch');
          const localCount = Object.values(loc.branches).filter((b) => b.isLocalOnly).length + 1;
          const newLocalBr = {
            id: newId,
            name: `👁️ 本端變化 ${localCount} (第${baseStep}手)`,
            isLocalOnly: true,
            moves: br.moves.slice(0, baseStep),
            cursor: baseStep,
            rezeroOffset: br.rezeroOffset || 0,
            setupStones: JSON.parse(JSON.stringify(br.setupStones || []))
          };
          loc.branches[newId] = newLocalBr;
          loc.activeBranchId = newId;
          br = newLocalBr;
          showToast(`已建立「${newLocalBr.name}」（僅您本端可見）`);
        }

        br.moves.push({
          color: nextColor,
          x,
          y,
          coord: getCoordLabel(x, y, state.boardSize)
        });
        br.cursor = br.moves.length;
        playStoneSound();
        updateAllRoomUI();
      }

      function createSpectatorLocalBranch() {
        if (!state || state.mode !== 'study' || isStudyPresenter()) return;
        const renderInfo = getStudyRenderState();
        activateSpectatorLocalStudy(renderInfo.activeBranchId, renderInfo.branch.cursor);
        const loc = appState.spectatorLocalStudy;
        const cur = loc.branches[loc.activeBranchId];
        const newId = generateId('spec_branch');
        const localCount = Object.values(loc.branches).filter((b) => b.isLocalOnly).length + 1;
        loc.branches[newId] = {
          id: newId,
          name: `👁️ 本端變化 ${localCount}`,
          isLocalOnly: true,
          moves: cur.moves.slice(0, cur.cursor),
          cursor: cur.cursor,
          rezeroOffset: cur.rezeroOffset || 0,
          setupStones: JSON.parse(JSON.stringify(cur.setupStones || []))
        };
        loc.activeBranchId = newId;
        updateAllRoomUI();
        showToast(`已建立「${loc.branches[newId].name}」，可自由點擊棋盤推演`);
      }

      function stepStudyCursor(delta) {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          const renderInfo = getStudyRenderState();
          const curBr = renderInfo.branch;
          const total = curBr.moves.length;
          let nextCursor = curBr.cursor;
          if (delta === -9999) nextCursor = 0;
          else if (delta === 9999) nextCursor = total;
          else nextCursor = Math.max(0, Math.min(total, curBr.cursor + delta));
          if (nextCursor === curBr.cursor) return;
          activateSpectatorLocalStudy(curBr.id, nextCursor);
          if (delta > 0) playStoneSound();
          updateAllRoomUI();
          return;
        }
        const branch = getActiveStudyBranch();
        const total = branch.moves.length;
        let nextCursor = branch.cursor;
        if (delta === -9999) nextCursor = 0;
        else if (delta === 9999) nextCursor = total;
        else nextCursor = Math.max(0, Math.min(total, branch.cursor + delta));

        if (nextCursor === branch.cursor) return;
        branch.cursor = nextCursor;
        rebuildStudyBoardAtCursor(branch);
        if (delta > 0) playStoneSound();
        updateAllRoomUI();

        if (studyCursorSyncTimer) clearTimeout(studyCursorSyncTimer);
        studyCursorSyncTimer = setTimeout(() => {
          studyCursorSyncTimer = null;
          persistCurrentRoomAndSync(true);
        }, 350);
      }

      function undoStudyMove() {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          const renderInfo = getStudyRenderState();
          const curBr = renderInfo.branch;
          if (!curBr.isLocalOnly) {
            stepStudyCursor(-1);
            return;
          }
          if (curBr.cursor <= 0) {
            showToast('目前已無可退回的手數');
            return;
          }
          curBr.moves = curBr.moves.slice(0, curBr.cursor - 1);
          curBr.cursor = curBr.moves.length;
          updateAllRoomUI();
          return;
        }
        const branch = getActiveStudyBranch();
        if (branch.cursor <= 0) {
          showToast('目前已無可退回的手數');
          return;
        }
        branch.moves = branch.moves.slice(0, branch.cursor - 1);
        branch.cursor = branch.moves.length;
        rebuildStudyBoardAtCursor(branch);
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
      }

      function rezeroStudyMoves() {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          showToast('目前由主講人控制盤面');
          return;
        }
        const branch = getActiveStudyBranch();
        branch.rezeroOffset = branch.cursor;
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
        showToast(`已將第 ${branch.cursor} 手設為起始點，後續落子將從第 1 手重新編號`);
      }

      function createNewStudyBranch() {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          createSpectatorLocalBranch();
          return;
        }
        const cur = getActiveStudyBranch();
        const newId = generateId('branch');
        const idx = Object.keys(state.studyBranches).length + 1;
        const newBranch = {
          id: newId,
          name: `變化圖 ${idx}`,
          moves: cur.moves.slice(0, cur.cursor),
          cursor: cur.cursor,
          rezeroOffset: cur.rezeroOffset || 0,
          setupStones: JSON.parse(JSON.stringify(cur.setupStones || []))
        };
        state.studyBranches[newId] = newBranch;
        state.activeBranchId = newId;
        rebuildStudyBoardAtCursor(newBranch);
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
        showToast(`已新增線程「${newBranch.name}」`);
      }

      function switchStudyBranch(branchId) {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          activateSpectatorLocalStudy(branchId, null);
          updateAllRoomUI();
          return;
        }
        if (!state.studyBranches[branchId]) return;
        state.activeBranchId = branchId;
        rebuildStudyBoardAtCursor(state.studyBranches[branchId]);
        persistCurrentRoomAndSync(true);
        updateAllRoomUI();
      }

      function renameActiveStudyBranch() {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          if (appState.spectatorLocalStudy) {
            const loc = appState.spectatorLocalStudy;
            const br = loc.branches[loc.activeBranchId];
            if (br && br.isLocalOnly) {
              openCustomPrompt('請輸入此本端變化圖名稱：', br.name, (name) => {
                if (name && name.trim()) {
                  br.name = name.trim().slice(0, 20);
                  updateAllRoomUI();
                }
              }, '命名本端變化圖');
              return;
            }
          }
          showToast('僅可重新命名自己建立的本端變化圖');
          return;
        }
        const branch = getActiveStudyBranch();
        openCustomPrompt('請輸入此變化圖線程名稱：', branch.name, (name) => {
          if (name && name.trim()) {
            branch.name = name.trim().slice(0, 20);
            persistCurrentRoomAndSync(true);
            updateAllRoomUI();
          }
        }, '命名變化圖線程');
      }

      function deleteActiveStudyBranch() {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          if (appState.spectatorLocalStudy) {
            const loc = appState.spectatorLocalStudy;
            const br = loc.branches[loc.activeBranchId];
            if (br && br.isLocalOnly) {
              delete loc.branches[br.id];
              loc.activeBranchId = state.activeBranchId || Object.keys(loc.branches)[0];
              updateAllRoomUI();
              showToast('已刪除本端變化圖');
              return;
            }
          }
          showToast('僅可刪除自己建立的本端變化圖');
          return;
        }
        const ids = Object.keys(state.studyBranches);
        if (ids.length <= 1) {
          showToast('至少需保留一個主線變化圖');
          return;
        }
        const branch = getActiveStudyBranch();
        openCustomConfirm(`確定要刪除「${branch.name}」嗎？`, () => {
          delete state.studyBranches[branch.id];
          state.activeBranchId = Object.keys(state.studyBranches)[0];
          rebuildStudyBoardAtCursor(state.studyBranches[state.activeBranchId]);
          persistCurrentRoomAndSync(true);
          updateAllRoomUI();
        }, '刪除變化圖');
      }

      function clearStudyBoard() {
        if (!state || state.mode !== 'study') return;
        if (!isStudyPresenter()) {
          showToast('目前由主講人控制盤面');
          return;
        }
        openCustomConfirm('確定要清空目前變化圖的所有棋子嗎？', () => {
          const branch = getActiveStudyBranch();
          branch.moves = [];
          branch.cursor = 0;
          branch.rezeroOffset = 0;
          branch.setupStones = [];
          rebuildStudyBoardAtCursor(branch);
          persistCurrentRoomAndSync(true);
          updateAllRoomUI();
        }, '清空棋盤');
      }

      // ==================== 10. SGF 產生、解析與「獨一雲端識別碼棋譜庫」 ====================
      function toSgfCoord(x, y) {
        if (x < 0 || y < 0) return '';
        return String.fromCharCode(97 + x) + String.fromCharCode(97 + y);
      }

      function fromSgfCoord(str) {
        if (!str || str.length < 2) return { x: -1, y: -1 };
        const x = str.charCodeAt(0) - 97;
        const y = str.charCodeAt(1) - 97;
        if (x < 0 || y < 0 || x >= 19 || y >= 19) return { x: -1, y: -1 };
        return { x, y };
      }

      function buildSgfFromCurrentRoom() {
        if (!state) return '(;GM[1]FF[4]SZ[19])';
        const size = state.boardSize || 19;
        const dateStr = new Date().toISOString().slice(0, 10);
        const pb = state.blackName || state.studyControllerName || '黑方';
        const pw = state.whiteName || '白方';
        const re = state.result ? (state.result.winner === 'B' ? 'B+R' : 'W+R') : '';
        let header = `(;GM[1]FF[4]CA[UTF-8]SZ[${size}]DT[${dateStr}]PB[${pb}]PW[${pw}]`;
        if (re) header += `RE[${re}]`;

        if (state.mode === 'study') {
          const renderInfo = getStudyRenderState();
          const branches = Object.values(renderInfo.branchesMap);
          const active = renderInfo.branch;
          const ordered = [active, ...branches.filter((b) => b.id !== active.id)];
          if (ordered.length === 1) {
            return header + serializeBranchNodes(ordered[0]) + ')';
          }
          const subTrees = ordered.map((b) => `(${serializeBranchNodes(b)})`).join('');
          return header + subTrees + ')';
        } else {
          if (appState.spectatorLocalMatch) {
            const loc = appState.spectatorLocalMatch;
            const active = loc.branches[loc.activeBranchId] || loc.branches.live_main;
            const all = Object.values(loc.branches);
            const ordered = [active, ...all.filter((b) => b.id !== active.id)];
            if (ordered.length > 1) {
              const subTrees = ordered.map((b) => `(${serializeBranchNodes(b)})`).join('');
              return header + subTrees + ')';
            }
            return header + serializeBranchNodes(active) + ')';
          }
          const movesStr = (state.moves || []).map((m) => `;${m.color}[${toSgfCoord(m.x, m.y)}]`).join('');
          return header + movesStr + ')';
        }
      }

      function serializeBranchNodes(branch) {
        let out = '';
        const ab = (branch.setupStones || []).filter((s) => s.color === 'B').map((s) => `[${toSgfCoord(s.x, s.y)}]`).join('');
        const aw = (branch.setupStones || []).filter((s) => s.color === 'W').map((s) => `[${toSgfCoord(s.x, s.y)}]`).join('');
        if (ab) out += `AB${ab}`;
        if (aw) out += `AW${aw}`;
        if (branch.name) out += `N[${branch.name.replace(/[\[\]]/g, '')}]`;
        const limit = Math.min(branch.cursor ?? branch.moves.length, branch.moves.length);
        for (let i = 0; i < limit; i++) {
          const m = branch.moves[i];
          out += `;${m.color}[${toSgfCoord(m.x, m.y)}]`;
        }
        return out;
      }

      function parseSgfData(raw) {
        const text = String(raw || '').trim();
        const sizeMatch = text.match(/SZ\[(\d+)\]/i);
        const boardSize = sizeMatch ? Math.min(19, Math.max(9, Number(sizeMatch[1]) || 19)) : 19;
        const setupStones = [];

        const abMatch = text.match(/AB((?:\[[a-s]{2}\])+)/i);
        if (abMatch) {
          const coords = abMatch[1].match(/\[([a-s]{2})\]/gi) || [];
          coords.forEach((c) => {
            const pt = fromSgfCoord(c.slice(1, 3).toLowerCase());
            if (pt.x >= 0) setupStones.push({ x: pt.x, y: pt.y, color: 'B' });
          });
        }
        const awMatch = text.match(/AW((?:\[[a-s]{2}\])+)/i);
        if (awMatch) {
          const coords = awMatch[1].match(/\[([a-s]{2})\]/gi) || [];
          coords.forEach((c) => {
            const pt = fromSgfCoord(c.slice(1, 3).toLowerCase());
            if (pt.x >= 0) setupStones.push({ x: pt.x, y: pt.y, color: 'W' });
          });
        }

        const subBranchMatches = [...text.matchAll(/\(\s*(?:N\[([^\]]*)\])?((?:\s*;[BW]\[[a-s]{0,2}\])+)\s*\)/gi)];
        const branches = {};

        if (subBranchMatches.length > 1) {
          subBranchMatches.forEach((m, idx) => {
            const id = idx === 0 ? 'branch_main' : generateId('branch');
            const name = (m[1] && m[1].trim()) || (idx === 0 ? '主線' : `變化圖 ${idx + 1}`);
            const moves = extractMovesFromSgfSegment(m[2], boardSize);
            branches[id] = {
              id,
              name,
              moves,
              cursor: moves.length,
              rezeroOffset: 0,
              setupStones: idx === 0 ? setupStones : JSON.parse(JSON.stringify(setupStones))
            };
          });
        } else {
          const moves = extractMovesFromSgfSegment(text, boardSize);
          branches.branch_main = {
            id: 'branch_main',
            name: '主線',
            moves,
            cursor: moves.length,
            rezeroOffset: 0,
            setupStones
          };
        }

        return { boardSize, branches };
      }

      function extractMovesFromSgfSegment(seg, boardSize) {
        const moves = [];
        const regex = /;([BW])\[([a-s]{0,2})\]/gi;
        let match;
        while ((match = regex.exec(seg)) !== null) {
          const color = match[1].toUpperCase();
          const coordStr = (match[2] || '').toLowerCase();
          if (!coordStr) {
            moves.push({ color, x: -1, y: -1, pass: true, coord: '虛手' });
          } else {
            const { x, y } = fromSgfCoord(coordStr);
            if (x >= 0 && y >= 0 && x < boardSize && y < boardSize) {
              moves.push({ color, x, y, coord: getCoordLabel(x, y, boardSize) });
            }
          }
        }
        return moves;
      }

