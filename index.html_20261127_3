<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>雲端圍棋對弈與研究室</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Firebase Compat SDKs（使用 Realtime Database 即時同步） -->
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
  <style>
    :root {
      --board-bg: #d9a45b;
      --board-border: #8c5822;
    }
    html, body {
      margin: 0;
      padding: 0;
      background-color: #f5f3ef;
      color: #1f2937;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    button {
      touch-action: manipulation;
    }
    #board-viewport {
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
    }
    .board-responsive-frame {
      width: 100%;
      max-width: 700px;
      aspect-ratio: 1 / 1;
    }
    @media (min-width: 1024px) {
      .board-responsive-frame {
        width: min(100%, 700px, calc(100dvh - 145px));
        max-width: 700px;
      }
    }
    canvas#go-board {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 12px;
      box-shadow: 0 10px 25px -5px rgba(68, 42, 14, 0.28), 0 4px 10px -2px rgba(68, 42, 14, 0.16);
      cursor: pointer;
    }
    .thin-scroll::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    .thin-scroll::-webkit-scrollbar-track {
      background: transparent;
    }
    .thin-scroll::-webkit-scrollbar-thumb {
      background: rgba(120, 113, 108, 0.35);
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- ==================== 極簡單排頂部導覽列 ==================== -->
  <header class="sticky top-0 z-30 bg-stone-900 text-stone-100 border-b border-stone-800 shadow-sm">
    <!-- 大廳模式頂部列 -->
    <div id="header-lobby-bar" class="max-w-6xl mx-auto px-3 sm:px-5 h-12 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-amber-500 text-stone-950 font-black text-sm shrink-0">棋</span>
        <span class="font-bold text-sm sm:text-base tracking-wide truncate">雲端圍棋對弈與研究室</span>
        <span id="firebase-status-badge" class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-stone-800 border border-stone-700 text-[11px] font-semibold text-amber-300 shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span>連線 RTDB 中...</span>
        </span>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <button id="my-matches-btn-lobby" type="button" title="我的對戰房間" aria-label="我的對戰房間" class="relative inline-flex items-center justify-center w-8 h-8 rounded-full bg-stone-800 hover:bg-stone-700 active:bg-stone-600 border border-stone-700 text-sm transition shrink-0">
          <span>⚔️</span>
          <span id="my-matches-badge-lobby" class="hidden absolute -top-1 -right-1 min-w-[16px] h-4 px-1 rounded-full bg-emerald-500 text-stone-950 font-black text-[10px] leading-none flex items-center justify-center shadow-xs">0</span>
        </button>
        <button id="edit-nickname-btn-lobby" type="button" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-stone-800 hover:bg-stone-700 border border-stone-700 text-xs sm:text-sm font-medium transition shrink-0">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="header-nickname-text max-w-[110px] sm:max-w-[160px] truncate">棋友</span>
          <span class="text-stone-400 text-xs">✎</span>
        </button>
      </div>
    </div>

    <!-- 房間模式極簡單排頂部列 -->
    <div id="header-room-bar" class="hidden max-w-7xl mx-auto px-2.5 sm:px-5 h-11 flex items-center justify-between gap-1.5">
      <button id="back-to-lobby-btn" type="button" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-stone-800 hover:bg-stone-700 active:bg-stone-600 border border-stone-700 text-xs font-semibold text-stone-100 shrink-0 transition">
        <span>←</span>
        <span>大廳</span>
      </button>

      <div class="flex items-center gap-1 min-w-0">
        <button id="copy-room-code-btn" type="button" title="點擊複製房號" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-stone-800/90 hover:bg-stone-700 border border-stone-700/90 text-xs font-medium text-amber-300 min-w-0 truncate transition">
          <span id="header-room-meta" class="truncate">19路 · #000000</span>
          <span class="text-[11px] opacity-80 shrink-0">📋</span>
        </button>
        <button id="copy-room-link-btn" type="button" title="複製房間超連結" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-amber-600/90 hover:bg-amber-500 text-white text-xs font-bold shrink-0 transition">
          <span>🔗</span>
          <span class="hidden sm:inline">分享連結</span>
        </button>
      </div>

      <div class="flex items-center gap-1.5 shrink-0">
        <button id="my-matches-btn-room" type="button" title="我的對戰房間" aria-label="我的對戰房間" class="relative inline-flex items-center justify-center w-8 h-8 rounded-full bg-stone-800 hover:bg-stone-700 active:bg-stone-600 border border-stone-700 text-sm transition shrink-0">
          <span>⚔️</span>
          <span id="my-matches-badge-room" class="hidden absolute -top-1 -right-1 min-w-[16px] h-4 px-1 rounded-full bg-emerald-500 text-stone-950 font-black text-[10px] leading-none flex items-center justify-center shadow-xs">0</span>
        </button>
        <button id="edit-nickname-btn-room" type="button" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-stone-800 hover:bg-stone-700 border border-stone-700 text-xs font-medium shrink-0 transition">
          <span id="header-role-dot" class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
          <span id="header-role-badge" class="text-[11px] font-bold text-emerald-300 shrink-0">旁觀</span>
          <span class="text-stone-600 text-[10px]">|</span>
          <span class="header-nickname-text max-w-[68px] sm:max-w-[130px] truncate">棋友</span>
          <span class="text-stone-400 text-[11px] shrink-0">✎</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== 遊戲大廳視圖 ==================== -->
  <main id="lobby-view" class="flex-1 max-w-6xl w-full mx-auto px-3 sm:px-5 py-4">
    <!-- Firebase 連線異常提示橫幅（僅在連線失敗時顯示） -->
    <div id="firebase-error-banner" class="hidden mb-3 p-3 rounded-2xl bg-rose-50 border border-rose-300 text-rose-900 text-xs sm:text-sm flex flex-wrap items-center justify-between gap-2">
      <div class="space-y-0.5">
        <div class="font-bold">⚠️ Firebase Realtime Database 連線異常</div>
        <div id="firebase-error-detail" class="text-xs text-rose-700">請確認已在 Firebase Console 啟用 Realtime Database，且讀寫安全規則已正確設定。</div>
      </div>
      <button id="retry-firebase-btn" type="button" class="px-3 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold shrink-0 transition">🔄 重新連線</button>
    </div>

    <!-- 頂部操作與篩選列 -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 mb-4">
      <div class="flex items-center gap-1.5 bg-stone-200/80 p-1 rounded-xl overflow-x-auto max-w-full">
        <button type="button" data-lobby-tab="all" class="lobby-tab-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-bold bg-white text-stone-900 shadow-sm whitespace-nowrap transition">全部房間</button>
        <button type="button" data-lobby-tab="match" class="lobby-tab-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-stone-600 hover:text-stone-900 whitespace-nowrap transition">⚔️ 雙人對弈</button>
        <button type="button" data-lobby-tab="study" class="lobby-tab-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-stone-600 hover:text-stone-900 whitespace-nowrap transition">🔬 擺盤研究</button>
        <button type="button" data-lobby-tab="records" class="lobby-tab-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-stone-600 hover:text-stone-900 whitespace-nowrap transition">☁️ 我的棋譜</button>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
        <a href="#lobby-chat-section" class="lg:hidden inline-flex items-center gap-1 px-3 py-2 rounded-xl bg-stone-200 hover:bg-stone-300 text-stone-800 text-xs font-bold transition">
          <span>💬 大廳聊天</span>
        </a>
        <button id="open-create-modal-btn" type="button" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 active:bg-amber-700 text-white text-xs sm:text-sm font-bold shadow-sm transition">
          <span>＋ 建立房間</span>
        </button>
      </div>
    </div>

    <!-- 搜尋與房號/連結快速進房列 -->
    <div class="mb-4 flex items-center gap-2">
      <div class="relative flex-1">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-sm">🔍</span>
        <input id="lobby-search-input" type="text" placeholder="搜尋房名、房號、貼上房間連結或棋友暱稱..." class="w-full pl-9 pr-8 py-2 rounded-xl bg-white border border-stone-300 focus:border-amber-500 focus:outline-none text-xs sm:text-sm" />
        <button id="clear-search-btn" type="button" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-700 text-xs font-bold">✕</button>
      </div>
      <button id="quick-enter-by-query-btn" type="button" class="hidden px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-bold shrink-0 shadow-xs transition">立即進房 →</button>
    </div>

    <!-- 大廳雙欄主體 -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
      <!-- 左側：房間列表與我的棋譜 -->
      <div class="lg:col-span-7 space-y-3">
        <div id="lobby-rooms-container">
          <div class="flex items-center justify-between gap-2 mb-2 px-1">
            <div class="flex items-center gap-2 min-w-0 flex-wrap">
              <span id="lobby-rooms-count-label" class="text-xs font-semibold text-stone-500">正在從 Firebase 載入房間...</span>
              <span id="lobby-waiting-count-badge" class="hidden inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-100 border border-amber-300 text-amber-900 text-[11px] font-black">🔥 0 間等待對局</span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="hidden sm:inline text-[11px] text-stone-400">Realtime Database 即時同步</span>
              <button id="refresh-rooms-btn" type="button" class="px-2 py-0.5 rounded-lg bg-white hover:bg-stone-100 border border-stone-300 text-stone-700 text-[11px] font-bold transition">🔄 刷新雲端</button>
            </div>
          </div>
          <div id="lobby-rooms-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
        </div>

        <div id="lobby-records-container" class="hidden space-y-2.5">
          <!-- 獨一雲端棋譜識別碼管理卡片 -->
          <div class="p-3 rounded-2xl bg-amber-50/90 border border-amber-200 space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-1.5 min-w-0 flex-wrap">
                <span class="text-xs font-bold text-amber-950 shrink-0">🔑 雲端棋譜識別碼：</span>
                <span id="vault-code-display" class="px-2 py-0.5 rounded-lg bg-white border border-amber-300 font-mono font-black text-xs text-amber-900 select-all">WQ-0000-KAYA</span>
                <span id="vault-stats-badge" class="px-2 py-0.5 rounded-lg bg-emerald-100 border border-emerald-300 text-emerald-900 font-bold text-[11px] shrink-0">🏆 0勝 0敗</span>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                <button id="copy-vault-code-btn" type="button" class="px-2.5 py-1 rounded-lg bg-white hover:bg-amber-100 border border-amber-300 text-amber-900 text-[11px] font-bold transition">📋 複製</button>
                <button id="switch-vault-code-btn" type="button" class="px-2.5 py-1 rounded-lg bg-amber-600 hover:bg-amber-500 text-white text-[11px] font-bold transition">🔄 切換／自訂</button>
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-2 pt-1.5 border-t border-amber-200/70 text-[11px] text-amber-900/90">
              <span>免登入跨手機／電腦與所有升級版本永久同步</span>
              <div class="flex items-center gap-1.5">
                <button id="export-vault-backup-btn" type="button" class="px-2 py-0.5 rounded bg-white hover:bg-amber-100 border border-amber-300 font-bold text-amber-900 transition">📦 匯出備份</button>
                <button id="import-vault-backup-btn" type="button" class="px-2 py-0.5 rounded bg-white hover:bg-amber-100 border border-amber-300 font-bold text-amber-900 transition">📥 還原備份</button>
                <input id="vault-backup-file-input" type="file" accept=".json,application/json" class="hidden" />
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between px-1">
            <span id="lobby-records-count-label" class="text-xs font-semibold text-stone-500">☁️ 獨立雲端棋譜庫</span>
            <button id="lobby-import-sgf-btn" type="button" class="text-xs font-bold text-amber-700 hover:text-amber-800 underline">＋ 匯入 SGF 至雲端</button>
          </div>
          <div id="lobby-records-grid" class="space-y-2.5"></div>
        </div>
      </div>

      <!-- 右側：大廳線上聊天室（最多保存 300 則留言） -->
      <aside id="lobby-chat-section" class="lg:col-span-5 lg:sticky lg:top-16 bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden flex flex-col">
        <div class="px-3.5 py-2.5 bg-stone-100 border-b border-stone-200 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="text-sm">💬</span>
            <h2 class="font-bold text-xs sm:text-sm text-stone-800">大廳線上聊天室</h2>
          </div>
          <span id="lobby-chat-count" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-stone-200 text-stone-600">0 / 300 則</span>
        </div>

        <div class="px-3 py-2 bg-stone-50 border-b border-stone-100 flex items-center gap-1.5 overflow-x-auto thin-scroll">
          <button type="button" data-lobby-quick="大家好！" class="lobby-quick-btn px-2 py-1 rounded-lg bg-white hover:bg-amber-50 border border-stone-200 text-[11px] font-medium text-stone-700 whitespace-nowrap">大家好！</button>
          <button type="button" data-lobby-quick="19路求對手！" class="lobby-quick-btn px-2 py-1 rounded-lg bg-white hover:bg-amber-50 border border-stone-200 text-[11px] font-medium text-stone-700 whitespace-nowrap">19路求對手！</button>
          <button type="button" data-lobby-quick="13路來一局" class="lobby-quick-btn px-2 py-1 rounded-lg bg-white hover:bg-amber-50 border border-stone-200 text-[11px] font-medium text-stone-700 whitespace-nowrap">13路來一局</button>
          <button type="button" data-lobby-quick="9路快棋！" class="lobby-quick-btn px-2 py-1 rounded-lg bg-white hover:bg-amber-50 border border-stone-200 text-[11px] font-medium text-stone-700 whitespace-nowrap">9路快棋！</button>
          <button type="button" data-lobby-quick="歡迎進房研究" class="lobby-quick-btn px-2 py-1 rounded-lg bg-white hover:bg-amber-50 border border-stone-200 text-[11px] font-medium text-stone-700 whitespace-nowrap">歡迎進房研究</button>
        </div>

        <div id="lobby-chat-messages" class="p-3 h-64 sm:h-80 overflow-y-auto thin-scroll space-y-2 text-xs sm:text-sm bg-stone-50/40"></div>

        <form id="lobby-chat-form" class="p-2.5 bg-white border-t border-stone-200 flex items-center gap-2">
          <input id="lobby-chat-input" type="text" maxlength="200" placeholder="在大廳約戰或打聲招呼..." class="flex-1 px-3 py-1.5 rounded-xl bg-stone-100 focus:bg-white border border-stone-200 focus:border-amber-500 focus:outline-none text-xs sm:text-sm" />
          <button type="submit" class="px-3.5 py-1.5 rounded-xl bg-stone-800 hover:bg-stone-700 text-white text-xs font-bold shrink-0 transition">發送</button>
        </form>
      </aside>
    </div>
  </main>

  <!-- ==================== 房間視圖（雙人對弈 / 擺盤研究室） ==================== -->
  <main id="room-view" class="hidden flex-1 max-w-7xl w-full mx-auto px-2.5 sm:px-5 py-2 sm:py-3">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 sm:gap-5 items-start">

      <!-- 左側主區：狀態列 + 棋盤 + 棋盤正下方快捷操作列 -->
      <div class="lg:col-span-7 flex flex-col items-center">
        <!-- 棋盤上方狀態列（桌面版及擺盤研究室顯示） -->
        <div id="classic-top-status-bar" class="w-full max-w-[700px] mx-auto mb-1.5 px-3 py-1.5 rounded-xl bg-white border border-stone-200 shadow-xs flex items-center justify-between gap-2 text-xs sm:text-sm">
          <div class="flex items-center gap-2 min-w-0">
            <span id="turn-stone-indicator" class="w-3.5 h-3.5 rounded-full bg-stone-900 border border-stone-400 shrink-0"></span>
            <span id="turn-status-text" class="font-bold text-stone-800 truncate">黑方回合 · 第 1 手</span>
          </div>
          <span id="turn-sub-hint" class="text-[11px] sm:text-xs text-stone-500 shrink-0">點擊交叉點落子</span>
        </div>

        <!-- 手機／平板雙人對弈單排迷你計時 HUD -->
        <div id="match-top-hud-bar" class="hidden w-full max-w-[700px] mx-auto mb-1.5 px-2 py-1 rounded-xl bg-white border border-stone-200 shadow-xs items-center justify-between gap-1.5 text-xs">
          <!-- 黑方計時膠囊 -->
          <div id="hud-black-pill" class="flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-stone-100 text-stone-800 min-w-0 transition-colors">
            <span class="w-2.5 h-2.5 rounded-full bg-stone-900 border border-stone-500 shrink-0"></span>
            <span id="hud-black-clock" class="font-mono font-black text-xs shrink-0">無限</span>
            <span id="hud-black-byo" class="text-[10px] font-bold opacity-85 truncate"></span>
          </div>

          <!-- 中央手數指示 -->
          <div id="hud-center-info" class="flex items-center justify-center gap-1 min-w-0 px-1 text-[11px] font-bold text-stone-600">
            <span id="hud-turn-dot" class="w-2 h-2 rounded-full bg-stone-900 border border-stone-400 shrink-0"></span>
            <span id="hud-center-text" class="truncate">第 1 手</span>
          </div>

          <!-- 白方計時膠囊 -->
          <div id="hud-white-pill" class="flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-stone-100 text-stone-800 min-w-0 transition-colors">
            <span id="hud-white-byo" class="text-[10px] font-bold opacity-85 truncate"></span>
            <span id="hud-white-clock" class="font-mono font-black text-xs shrink-0">無限</span>
            <span class="w-2.5 h-2.5 rounded-full bg-white border border-stone-400 shrink-0"></span>
          </div>
        </div>

        <!-- 棋盤畫布容器 -->
        <div id="board-viewport" class="board-responsive-frame mx-auto relative flex items-center justify-center">
          <canvas id="go-board"></canvas>
          <div id="board-floating-bubble" class="hidden pointer-events-none absolute top-3 left-1/2 -translate-x-1/2 z-10 px-3.5 py-1.5 rounded-full bg-stone-900/90 text-white text-xs font-bold shadow-lg whitespace-nowrap"></div>
        </div>

        <!-- 【雙人對弈室】棋盤正下方獨立操作列 -->
        <div id="match-primary-action-bar" class="w-full max-w-[700px] mx-auto mt-2 space-y-2">
          <!-- 狀態 1：虛手 (Pass) 與對弈者本地變化圖入口 -->
          <div id="match-pass-bar" class="grid grid-cols-2 gap-2">
            <button id="board-pass-btn" type="button" class="py-2.5 px-3 rounded-xl bg-white hover:bg-stone-100 active:bg-stone-200 border border-stone-300 text-stone-800 font-bold text-xs sm:text-sm shadow-xs transition flex items-center justify-center gap-1.5">
              <span>✋</span>
              <span>虛手 (Pass)</span>
            </button>
            <button id="player-open-local-var-btn" type="button" class="py-2.5 px-3 rounded-xl bg-emerald-50 hover:bg-emerald-100 active:bg-emerald-200 border border-emerald-300 text-emerald-900 font-bold text-xs sm:text-sm shadow-xs transition flex items-center justify-center gap-1.5">
              <span>🌿</span>
              <span>本地變化圖</span>
            </button>
          </div>

          <!-- 狀態 2：確認落子與取消 -->
          <div id="match-confirm-bar" class="hidden grid grid-cols-3 gap-2">
