      async function cloudSetDoc(shortName, docId, data, options = {}) {
        if (!rtdb) throw new Error('RTDB_NOT_READY');
        const ref = getCloudRef(`${shortName}/${docId}`);
        const clean = sanitizeForRtdb(data);
        if (options.merge && clean && typeof clean === 'object' && !Array.isArray(clean)) {
          await withTimeout(ref.update(clean), 8000, 'WRITE_TIMEOUT');
        } else {
          await withTimeout(ref.set(clean), 8000, 'WRITE_TIMEOUT');
        }
      }

