      function normalizeArrayFromRtdb(val) {
        if (Array.isArray(val)) return val.filter((item) => item !== undefined && item !== null);
        if (val && typeof val === 'object') {
          return Object.keys(val)
            .sort((a, b) => Number(a) - Number(b))
            .map((k) => val[k])
            .filter((item) => item !== undefined && item !== null);
        }
        return [];
      }

      function normalizeRoomFromRemote(raw) {
        if (!raw || typeof raw !== 'object') return null;
        const copy = { ...raw };
        const size = copy.boardSize || 19;
        if (!Array.isArray(copy.board) && typeof copy.boardFlat === 'string') {
          try {
            copy.board = JSON.parse(copy.boardFlat);
          } catch (e) {
            copy.board = createEmptyBoard(size);
          }
        }
        if (!Array.isArray(copy.board)) {
          copy.board = createEmptyBoard(size);
        }
        copy.moves = normalizeArrayFromRtdb(copy.moves);
        copy.captures = copy.captures && typeof copy.captures === 'object'
          ? { B: Number(copy.captures.B) || 0, W: Number(copy.captures.W) || 0 }
          : { B: 0, W: 0 };
        copy.activeMembers = copy.activeMembers && typeof copy.activeMembers === 'object' ? copy.activeMembers : {};

        if (copy.studyBranches && typeof copy.studyBranches === 'object') {
          Object.values(copy.studyBranches).forEach((br) => {
            if (br && typeof br === 'object') {
              br.moves = normalizeArrayFromRtdb(br.moves);
              br.setupStones = normalizeArrayFromRtdb(br.setupStones);
              br.cursor = Number(br.cursor) || 0;
              br.rezeroOffset = Number(br.rezeroOffset) || 0;
            }
          });
        }
        return copy;
      }

